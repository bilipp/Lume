    "Jump straight into your favorite titles and channels." : {
      "comment" : "Widget description",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل مباشرةً إلى عناوينك وقنواتك المفضلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte direkt deine Lieblingstitel und -sender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accede directamente a tus títulos y canales favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez directement à vos titres et chaînes favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai direttamente ai tuoi titoli e canali preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りの作品やチャンネルにすばやくアクセス。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾는 콘텐츠와 채널로 바로 이동하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga direct naar je favoriete titels en zenders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź od razu do ulubionych tytułów i kanałów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceda diretamente aos seus títulos e canais favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу переходите к любимым материалам и каналам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favori içeriklerinize ve kanallarınıza doğrudan geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速打开您收藏的内容和频道。"
          }
