    "whatsNew.2_3.matchContent.note" : {
      "comment" : "What’s New 2.3 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد التلفاز يُظلم عند تبديل القنوات عند تشغيل «مطابقة المحتوى»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Senderwechsel wird dein Fernseher nicht mehr schwarz, wenn „Inhalt angleichen“ aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing channels no longer makes your TV go dark when Match Content is on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar de canal ya no deja tu televisor en negro cuando «Ajustar al contenido» está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de chaîne n’éteint plus l’écran de votre téléviseur quand « Adapter au contenu » est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare canale non fa più diventare nero il televisore quando “Adatta al contenuto” è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コンテンツに合わせる」がオンでも、チャンネル切り替え時にテレビが暗転しなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘콘텐츠 일치’를 켜도 채널을 바꿀 때 더 이상 TV 화면이 꺼지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tv wordt niet meer zwart bij het wisselen van zender als ‘Stem af op content’ aanstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana kanału nie powoduje już wygaszenia telewizora, gdy włączona jest opcja „Dopasuj zawartość”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar de canal não apaga mais a tela da TV quando “Corresponder ao conteúdo” está ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При включенном «Подборе параметров» экран телевизора больше не гаснет при переключении каналов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçeriğe Uydur açıkken kanal değiştirmek artık TV’nizin ekranını karartmıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“匹配内容”后，换台时电视不再黑屏。"
          }
        }
      }
    },
