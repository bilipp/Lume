    "whatsNew.3_3.macCurrentWindow.summary" : {
      "comment" : "What’s New 3.3 highlight summary. macOS only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد جديد في المشغّل يفتح الفيديو في نافذة المكتبة بدلًا من نافذة جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Player-Einstellung öffnet Videos im Mediathekfenster statt in einem neuen Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new Player setting opens videos in the library window instead of a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo ajuste del reproductor abre los vídeos en la ventana de la biblioteca en lugar de en una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau réglage du lecteur ouvre les vidéos dans la fenêtre de la bibliothèque plutôt que dans une nouvelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova impostazione del lettore apre i video nella finestra della libreria anziché in una nuova."
