        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 시청한 콘텐츠를 한눈에 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie in één oogopslag wat je al hebt bekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu widać, co już obejrzano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja num relance o que você já assistiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу видно, что вы уже посмотрели."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neleri izlediğinizi bir bakışta görün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看出你已经看过的内容。"
          }
        }
      }
