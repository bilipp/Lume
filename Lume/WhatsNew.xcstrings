        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어에서 바로 음량을 조절하거나 음소거하세요. 키보드로도 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas het volume aan of zet het geluid uit, direct in de speler en ook met het toetsenbord."
