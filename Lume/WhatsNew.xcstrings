    "whatsNew.2_1.fasterStart.summary" : {
      "comment" : "What’s New 2.1 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع عدة قوائم تشغيل، ينتظر Lume القائمة التي تشاهدها فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei mehreren Playlists wartet Lume nur auf die, die du gerade schaust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With several playlists, Lume waits only for the one you’re watching."
          }
        },
        "es" : {
          "stringUnit" : {
