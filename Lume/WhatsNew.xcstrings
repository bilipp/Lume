    "whatsNew.1_1.languages.summary" : {
      "comment" : "What’s New 1.1 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume يتحدث الآن الفرنسية والإسبانية والإيطالية والبرتغالية واليابانية والكورية والصينية."
          }
        },
        "de" : {
          "stringUnit" : {
