    "whatsNew.2_5.macVolume.summary" : {
      "comment" : "What’s New 2.5 highlight summary. macOS only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر مستوى الصوت أو اكتمه مباشرةً في المشغّل، وباستخدام لوحة المفاتيح أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändere die Lautstärke oder schalte stumm direkt im Player, auch per Tastatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the volume or mute right in the player, also with the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el volumen o silencia directamente en el reproductor, también con el teclado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez le volume ou coupez le son directement dans le lecteur, aussi au clavier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia il volume o disattiva l’audio direttamente nel lettore, anche da tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤー内で音量の変更や消音ができ、キーボードでも操作できます。"
