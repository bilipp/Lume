          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar de canal se mantiene la última imagen hasta que empieza el siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En changeant de chaîne, la dernière image reste affichée jusqu’au démarrage de la suivante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiando canale, l’ultima immagine resta finché non parte il successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルを切り替えても、次の映像が始まるまで直前の映像が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 바꿀 때 다음 채널이 시작될 때까지 마지막 화면이 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het wisselen van zender blijft het laatste beeld staan tot de volgende start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy zmianie kanału ostatni obraz zostaje na ekranie, aż ruszy następny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao trocar de canal, a última imagem fica na tela até o próximo começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При переключении канала последний кадр остается на экране, пока не начнется следующий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanal değiştirirken son görüntü, sonraki kanal başlayana kadar ekranda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换台时，会保留上一个画面，直到下一个频道开始播放。"
          }
        }
      }
    },
