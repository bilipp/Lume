    "whatsNew.2_4.programmeMenu.summary" : {
      "comment" : "What’s New 2.4 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على برنامج في الدليل لمشاهدته أو تسجيله أو عرض تفاصيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke im Programmführer lange auf eine Sendung, um sie anzusehen, aufzunehmen oder Details zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press a programme in the guide to watch, record or see details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un programa en la guía para verlo, grabarlo o ver los detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une émission dans le guide pour la regarder, l’enregistrer ou voir les détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto su un programma nella guida per guardarlo, registrarlo o vederne i dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "番組表で番組を長押しすると、視聴、録画、詳細表示ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편성표에서 프로그램을 길게 눌러 시청, 녹화하거나 세부사항을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een programma in de gids ingedrukt om te kijken, op te nemen of details te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj program w programie TV, aby go oglądać, nagrać lub zobaczyć szczegóły."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
