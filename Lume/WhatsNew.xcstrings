        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een nieuwe spelerinstelling open je video's in het bibliotheekvenster in plaats van in een nieuw venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe ustawienie odtwarzacza otwiera wideo w oknie biblioteki zamiast w nowym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
