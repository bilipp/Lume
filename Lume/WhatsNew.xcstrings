      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترجمة والصوت اللذان تختارهما يدويًا يبقيان محددين في الحلقة التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dir gewählte Untertitel und Tonspuren bleiben für die nächste Folge ausgewählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitles and audio you choose by hand stay selected for the next episode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos y el audio que eliges a mano se mantienen en el siguiente episodio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres et l’audio que vous choisissez restent sélectionnés pour l’épisode suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli e l’audio che scegli restano selezionati per l’episodio successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動で選んだ字幕と音声は、次のエピソードでもそのまま選択されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 선택한 자막과 오디오가 다음 에피소드에서도 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondertitels en audio die je zelf kiest, blijven geselecteerd voor de volgende aflevering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ręcznie wybrane napisy i dźwięk pozostają zaznaczone w następnym odcinku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
