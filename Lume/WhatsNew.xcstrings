    "whatsNew.3_0.skipIntro.note" : {
      "comment" : "What’s New 3.0 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى زر «تخطي المقدمة» متاحًا عند ظهور عناصر التحكم في المشغّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Intro überspringen“ bleibt erreichbar, wenn die Player-Steuerung eingeblendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip Intro stays reachable when the player controls are showing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Omitir intro» sigue disponible cuando se muestran los controles del reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Passer le générique » reste accessible quand les commandes du lecteur sont affichées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Salta sigla” resta raggiungibile quando sono visibili i controlli del lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーのコントロールが表示されていても「イントロをスキップ」を押せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어 컨트롤이 표시되어 있어도 ‘인트로 건너뛰기’를 누를 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Sla intro over’ blijft bereikbaar als de spelerknoppen in beeld zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk „Pomiń czołówkę” jest dostępny, gdy widać sterowanie odtwarzacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pular Abertura continua acessível quando os controles do player estão visíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Пропустить заставку» доступна, даже когда показаны элементы управления плеера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcı denetimleri görünürken Girişi Atla erişilebilir kalıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放器控件显示时，仍可使用“跳过片头”。"
          }
        }
      }
    },
    "whatsNew.3_0.syncNow.note" : {
      "comment" : "What’s New 3.0 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«المزامنة الآن» في الإعدادات › المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Jetzt synchronisieren“ unter Einstellungen › Synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync Now in Settings › Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sincronizar ahora» en Ajustes › Sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Synchroniser maintenant » dans Réglages › Synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sincronizza ora” in Impostazioni › Sincronizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「同期」に「今すぐ同期」が加わりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 동기화에서 ‘지금 동기화’를 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Synchroniseer nu’ in Instellingen › Synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Synchronizuj teraz” w Ustawienia › Synchronizacja."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar Agora em Ajustes › Sincronizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Синхронизировать сейчас» в разделе «Настройки» › «Синхронизация»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar › Eşzamanlama’da Şimdi Eşzamanla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置 › 同步”中新增“立即同步”。"
          }
        }
      }
    },
    "whatsNew.3_0.watchedBadges.summary" : {
      "comment" : "What’s New 3.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف بنظرة واحدة ما شاهدته من قبل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh auf einen Blick, was du schon gesehen hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See at a glance what you’ve already watched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve de un vistazo lo que ya has visto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez d’un coup d’œil ce que vous avez déjà regardé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi a colpo d’occhio cosa hai già guardato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴済みの作品がひと目でわかります。"
          }
