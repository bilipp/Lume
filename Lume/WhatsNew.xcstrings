    "whatsNew.1_0.resume.summary" : {
      "comment" : "What’s New 1.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتذكر الأفلام والمسلسلات أين توقفت، والحلقة التالية جاهزة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Serien merken sich, wo du aufgehört hast, und die nächste Folge steht bereit."
