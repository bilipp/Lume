    "whatsNew.1_5.subscription.summary" : {
      "comment" : "What’s New 1.5 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبح Lume Pro اشتراكًا شهريًا يمكنك إدارته أو إلغاؤه في الإعدادات. عمليات الشراء مدى الحياة تبقى كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro ist jetzt ein Monatsabo, das du in den Einstellungen verwalten oder kündigen kannst. Lebenslange Freischaltungen bleiben, wie sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro is now a monthly subscription you can manage or cancel in Settings. Lifetime unlocks stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro es ahora una suscripción mensual que puedes gestionar o cancelar en Ajustes. Las compras de por vida no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro devient un abonnement mensuel que vous pouvez gérer ou résilier dans Réglages. Les achats à vie restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro è ora un abbonamento mensile che puoi gestire o annullare in Impostazioni. Gli sblocchi a vita restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Proが月額サブスクリプションになり、設定で管理・解約できます。買い切りで購入済みの方はそのままご利用いただけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro가 이제 설정에서 관리하거나 취소할 수 있는 월간 구독입니다. 평생 이용권은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro is nu een maandabonnement dat je in Instellingen kunt beheren of opzeggen. Levenslange ontgrendelingen blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro to teraz miesięczna subskrypcja, którą można zarządzać lub anulować w Ustawieniach. Dożywotnie odblokowania pozostają bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lume Pro agora é uma assinatura mensal que você pode gerenciar ou cancelar nos Ajustes. Desbloqueios vitalícios continuam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro теперь ежемесячная подписка, которой можно управлять или отменить в Настройках. Пожизненные покупки остаются в силе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro artık Ayarlar’dan yönetebileceğiniz veya iptal edebileceğiniz aylık bir abonelik. Ömür boyu kilit açmalar olduğu gibi kalıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Pro 现为月度订阅，可在“设置”中管理或取消。终身解锁保持不变。"
          }
        }
      }
    },
