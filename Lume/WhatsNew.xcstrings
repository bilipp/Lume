    "whatsNew.3_2.combinedLumeCloud.summary" : {
      "comment" : "What’s New 3.2 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد العرض المدمج يُزامَن الآن بين أجهزتك عبر Lume Cloud أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Einrichtung der kombinierten Ansicht wird jetzt auch mit Lume Cloud zwischen deinen Geräten synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Combined View setup now syncs across your devices with Lume Cloud too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu configuración de la vista combinada ahora también se sincroniza entre tus dispositivos con Lume Cloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre configuration de la vue combinée se synchronise désormais aussi entre vos appareils avec Lume Cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configurazione della vista combinata ora si sincronizza tra i tuoi dispositivi anche con Lume Cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "統合ビューの設定が、Lume Cloudでもデバイス間で同期されるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 보기 설정이 이제 Lume Cloud로도 기기 간에 동기화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je instellingen voor de gecombineerde weergave worden nu ook via Lume Cloud tussen je apparaten gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguracja widoku połączonego synchronizuje się teraz między urządzeniami także przez Lume Cloud."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua configuração da visualização combinada agora também é sincronizada entre seus dispositivos com o Lume Cloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки объединенного вида теперь синхронизируются между устройствами и через Lume Cloud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birleşik Görünüm ayarlarınız artık Lume Cloud ile de aygıtlarınız arasında eşzamanlanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并视图的设置现在也可通过 Lume Cloud 在你的设备间同步。"
          }
        }
      }
    },
