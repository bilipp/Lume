    "whatsNew.3_1.combinedView.summary" : {
      "comment" : "What’s New 3.1 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفّح عدة قوائم تشغيل معًا في البث المباشر والأفلام والمسلسلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchstöbere mehrere Playlists gemeinsam in Live-TV, Filme und Serien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse several playlists together in Live TV, Movies and Series."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora varias listas juntas en TV en directo, Películas y Serie."
