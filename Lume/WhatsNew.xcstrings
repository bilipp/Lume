    "whatsNew.1_5.stalkerBrowse.summary" : {
      "comment" : "What’s New 1.5 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحمَّل الأفلام والمسلسلات أثناء التصفح، ويجري البحث على البوابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme und Serien laden beim Stöbern, und die Suche läuft direkt auf dem Portal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movies and series load as you browse, and search runs on the portal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas y series se cargan mientras exploras, y la búsqueda se hace en el portal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films et séries se chargent pendant que vous naviguez, et la recherche se fait sur le portail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film e serie si caricano mentre sfogli, e la ricerca avviene sul portale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やシリーズはブラウズしながら読み込まれ、検索はポータル側で行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보는 동안 영화와 시리즈가 로드되고, 검색은 포털에서 실행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films en series laden terwijl je bladert, en zoeken gebeurt op het portaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy i seriale wczytują się podczas przeglądania, a wyszukiwanie odbywa się na portalu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes e séries carregam enquanto você navega, e a busca é feita no portal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фильмы и сериалы загружаются по мере просмотра каталога, а поиск выполняется на портале."
          }
        },
        "tr" : {
          "stringUnit" : {
