    "whatsNew.1_0.icloud.summary" : {
      "comment" : "What’s New 1.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات الشخصية والتقدم والمفضلة تتبعك على جميع أجهزتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile, Fortschritt und Favoriten folgen dir auf all deine Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles, progress and favorites follow you across your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfiles, progreso y favoritos te acompañan en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profils, progression et favoris vous suivent sur tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profili, avanzamento e preferiti ti seguono su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイル、視聴の進行状況、お気に入りがすべてのデバイスで共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필, 시청 진행 상황, 즐겨찾기가 모든 기기에서 함께합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profielen, voortgang en favorieten volgen je op al je apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile, postęp i ulubione są dostępne na wszystkich urządzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perfis, progresso e favoritos acompanham você em todos os seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили, прогресс и избранное доступны на всех ваших устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller, ilerleme ve favoriler tüm aygıtlarınızda sizinle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人资料、观看进度和收藏会在你的所有设备间同步。"
          }
        }
      }
    },
