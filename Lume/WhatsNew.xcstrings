    "whatsNew.3_3.macCurrentWindow.summary" : {
      "comment" : "What’s New 3.3 highlight summary. macOS only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد جديد في المشغّل يفتح الفيديو في نافذة المكتبة بدلًا من نافذة جديدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Player-Einstellung öffnet Videos im Mediathekfenster statt in einem neuen Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new Player setting opens videos in the library window instead of a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo ajuste del reproductor abre los vídeos en la ventana de la biblioteca en lugar de en una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouveau réglage du lecteur ouvre les vidéos dans la fenêtre de la bibliothèque plutôt que dans une nouvelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova impostazione del lettore apre i video nella finestra della libreria anziché in una nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーの新しい設定で、ビデオを新規ウインドウではなくライブラリのウインドウで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 플레이어 설정으로 비디오를 새 윈도우 대신 보관함 윈도우에서 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een nieuwe spelerinstelling open je video’s in het bibliotheekvenster in plaats van in een nieuw venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe ustawienie odtwarzacza otwiera wideo w oknie biblioteki zamiast w nowym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo ajuste do player abre os vídeos na janela da biblioteca em vez de em uma nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новая настройка плеера открывает видео в окне медиатеки, а не в новом окне."
          }
        },
        "tr" : {
          "stringUnit" : {
