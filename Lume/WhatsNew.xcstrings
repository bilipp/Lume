    "whatsNew.1_0.profiles.summary" : {
      "comment" : "What’s New 1.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح كل شخص ملفه الشخصي، واقفل الفئات برمز PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib allen ein eigenes Profil und sperre Kategorien mit einer PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give everyone their own profile, and lock categories with a PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da a cada persona su propio perfil y bloquea categorías con un PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez à chacun son profil et verrouillez des catégories avec un code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai a ognuno il proprio profilo e blocca le categorie con un PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族それぞれにプロファイルを作成し、カテゴリをPINでロックできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 각자의 프로필을 주고, PIN으로 카테고리를 잠그세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef iedereen een eigen profiel en vergrendel categorieën met een pincode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daj każdemu własny profil i blokuj kategorie kodem PIN."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a cada pessoa seu próprio perfil e bloqueie categorias com um PIN."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте каждому свой профиль и заблокируйте категории PIN-кодом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkese kendi profilini verin ve kategorileri bir PIN ile kilitleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每个人创建自己的个人资料，并用 PIN 码锁定类别。"
          }
        }
      }
    },
