    "whatsNew.3_1.serverDownloads.summary" : {
      "comment" : "What’s New 3.1 highlight summary. iOS, macOS only.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ الأفلام والحلقات من Plex و Jellyfin و Emby و Silo و WebDAV لمشاهدتها دون اتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Filme und Folgen von Plex, Jellyfin, Emby, Silo und WebDAV, um sie offline anzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save movies and episodes from Plex, Jellyfin, Emby, Silo and WebDAV to watch offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda películas y episodios de Plex, Jellyfin, Emby, Silo y WebDAV para verlos sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez des films et épisodes de Plex, Jellyfin, Emby, Silo et WebDAV pour les regarder hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva film ed episodi da Plex, Jellyfin, Emby, Silo e WebDAV per guardarli offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex、Jellyfin、Emby、Silo、WebDAVの映画やエピソードを保存して、オフラインで視聴できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex, Jellyfin, Emby, Silo, WebDAV의 영화와 에피소드를 저장해 오프라인으로 시청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar films en afleveringen van Plex, Jellyfin, Emby, Silo en WebDAV om offline te kijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj filmy i odcinki z Plex, Jellyfin, Emby, Silo i WebDAV, aby oglądać je offline."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve filmes e episódios do Plex, Jellyfin, Emby, Silo e WebDAV para assistir offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте фильмы и серии из Plex, Jellyfin, Emby, Silo и WebDAV для просмотра офлайн."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex, Jellyfin, Emby, Silo ve WebDAV’dan filmleri ve bölümleri çevrimdışı izlemek için kaydedin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存 Plex、Jellyfin、Emby、Silo 和 WebDAV 中的电影和剧集，离线观看。"
          }
        }
      }
    },
