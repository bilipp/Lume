      "comment" : "What’s New 2.4 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل على خادم التسجيل الخاص بك، وجدوِل البرامج من دليل البرامج."
          }
        },
