    "whatsNew.1_9.multiViewMute.note" : {
      "comment" : "What’s New 1.9 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد العرض المتعدد يتجمد عند كتم صوت إحدى النوافذ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View friert nicht mehr ein, wenn eine Kachel stummgeschaltet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View no longer freezes when a tile is muted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View ya no se congela cuando un recuadro está silenciado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View ne se fige plus quand une vignette est en sourdine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View non si blocca più quando un riquadro è silenziato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マルチビューでタイルを消音しても止まらなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멀티뷰에서 타일을 음소거해도 더 이상 멈추지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View loopt niet meer vast als een tegel gedempt is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View nie zawiesza się już po wyciszeniu kafelka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Multi-View não trava mais quando um bloco é silenciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-View больше не зависает, когда звук в окне выключен."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kutucuğun sesi kapatıldığında Çoklu Görünüm artık donmuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多画面中将某个画面静音时不再卡住。"
          }
        }
      }
    },
