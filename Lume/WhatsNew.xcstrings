    "whatsNew.2_2.fasterSync.summary" : {
      "comment" : "What’s New 2.2 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحديث يتخطى ما لم يتغير، ويبقى Lume سريع الاستجابة أثناء المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisierungen überspringen Unverändertes, und Lume reagiert auch während der Synchronisierung flüssig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refreshes skip what hasn’t changed, and Lume stays responsive while it syncs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones omiten lo que no ha cambiado y Lume sigue respondiendo mientras sincroniza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les actualisations ignorent ce qui n’a pas changé, et Lume reste réactif pendant la synchro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti saltano ciò che non è cambiato e Lume resta reattivo durante la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新時は変更のない部分をスキップし、同期中もLumeがスムーズに動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 고칠 때 바뀌지 않은 항목은 건너뛰고, 동기화 중에도 Lume이 빠르게 반응합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij het vernieuwen wordt overgeslagen wat niet is veranderd, en Lume blijft vlot tijdens het synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odświeżanie pomija to, co się nie zmieniło, a Lume działa płynnie podczas synchronizacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações pulam o que não mudou, e o Lume continua ágil durante a sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При обновлении пропускается то, что не изменилось, а Lume не тормозит во время синхронизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenilemeler değişmeyenleri atlar ve Lume eşzamanlama sırasında hızlı yanıt vermeye devam eder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刷新时会跳过未更改的内容，同步期间 Lume 依然反应灵敏。"
          }
        }
      }
    },
