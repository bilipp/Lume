    "whatsNew.3_1.favoritesKept.note" : {
      "comment" : "What’s New 3.1 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفضلة والقنوات المخفية لم تعد تختفي بعد إعادة ضبط المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriten und ausgeblendete Sender verschwinden nach einem Sync-Reset nicht mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorites and hidden channels no longer disappear after a sync reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los favoritos y canales ocultos ya no desaparecen tras restablecer la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris et chaînes masquées ne disparaissent plus après une réinitialisation de la synchro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferiti e canali nascosti non spariscono più dopo un ripristino della sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期をリセットしても、お気に入りと非表示のチャンネルが消えなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화를 재설정해도 즐겨찾기와 숨긴 채널이 더 이상 사라지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorieten en verborgen zenders verdwijnen niet meer na het resetten van de synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulubione i ukryte kanały nie znikają już po zresetowaniu synchronizacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoritos e canais ocultos não desaparecem mais após redefinir a sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избранное и скрытые каналы больше не пропадают после сброса синхронизации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favoriler ve gizli kanallar, eşzamanlama sıfırlandıktan sonra artık kaybolmuyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步重置后，收藏和隐藏的频道不再消失。"
          }
        }
      }
    },
    "whatsNew.3_1.hue.summary" : {
