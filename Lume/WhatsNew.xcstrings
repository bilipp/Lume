    "whatsNew.2_0.sports.summary" : {
      "comment" : "What’s New 2.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المباريات المباشرة والقادمة والترتيب والنتائج، وكل منها مرتبط بالقناة التي تعرضه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laufende und kommende Spiele, Tabellen und Ergebnisse, jeweils verknüpft mit dem Sender, der sie zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live and upcoming games, standings and results, each linked to the channel showing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partidos en directo y próximos, clasificaciones y resultados, cada uno enlazado al canal que lo emite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matchs en direct et à venir, classements et résultats, chacun relié à la chaîne qui le diffuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partite in diretta e in arrivo, classifiche e risultati, ognuno collegato al canale che lo trasmette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ中や今後の試合、順位表、結果を、放送チャンネルへのリンク付きで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진행 중이거나 예정된 경기, 순위, 결과를 확인하고 중계 채널로 바로 이동하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live en komende wedstrijden, standen en uitslagen, elk gekoppeld aan de zender die ze uitzendt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mecze na żywo i nadchodzące, tabele i wyniki, każdy powiązany z kanałem, który go pokazuje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogos ao vivo e próximos, classificações e resultados, cada um ligado ao canal que o transmite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие и предстоящие матчи, турнирные таблицы и результаты со ссылкой на канал трансляции."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı ve yaklaşan maçlar, puan durumları ve sonuçlar; her biri onu yayınlayan kanala bağlı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看正在进行和即将开始的比赛、排名和结果，每场都链接到转播频道。"
          }
        }
      }
    },
