        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De speler toont nu de beeldgrootte, het HDR-formaat, de audio en de bitrate van wat je kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzacz pokazuje teraz rozdzielczość obrazu, format HDR, dźwięk i przepływność tego, co oglądasz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O player agora mostra o tamanho da imagem, o formato HDR, o áudio e a taxa de bits do que você está assistindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плеер теперь показывает размер изображения, формат HDR, звук и битрейт того, что вы смотрите."
