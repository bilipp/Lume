    "whatsNew.1_5.missingArtwork.note" : {
      "comment" : "What’s New 1.5 note.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملصقات والشعارات تظهر مجددًا في قوائم التشغيل التي كانت تفتقدها."
          }
        },
        "de" : {
          "stringUnit" : {
