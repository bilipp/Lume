          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume now speaks French, Spanish, Italian, Portuguese, Japanese, Korean and Chinese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume ya está disponible en francés, español, italiano, portugués, japonés, coreano y chino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume est désormais disponible en français, espagnol, italien, portugais, japonais, coréen et chinois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
