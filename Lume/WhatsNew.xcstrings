    "whatsNew.1_0.guide.summary" : {
      "comment" : "What’s New 1.0 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف ما يُعرض الآن وما يليه على كل قناة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh auf jedem Sender, was jetzt und als Nächstes läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what’s on now and next on every channel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta qué se emite ahora y a continuación en cada canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez ce qui passe maintenant et ensuite sur chaque chaîne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi cosa c’è in onda ora e dopo su ogni canale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各チャンネルの現在と次の番組を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 채널에서 지금 방송 중인 프로그램과 다음 프로그램을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie wat er nu en straks op elke zender is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz, co leci teraz i co będzie dalej na każdym kanale."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o que passa agora e a seguir em cada canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видно, что идет сейчас и что будет дальше на каждом канале."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kanalda şimdi ve sırada ne olduğunu görün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看每个频道正在播出和接下来的节目。"
          }
        }
      }
    },
