    "whatsNew.3_2.engineOrder.note" : {
      "comment" : "What’s New 3.2 note in the release history.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التثبيتات الجديدة تجرّب AetherEngine أولًا. ترتيب المحركات الذي حفظته يبقى كما هو."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Installationen versuchen zuerst AetherEngine. Eine von dir gespeicherte Engine-Reihenfolge bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New installs try AetherEngine first. An engine order you saved is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las instalaciones nuevas prueban primero AetherEngine. Se conserva el orden de motores que hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles installations essaient d'abord AetherEngine. L'ordre des moteurs que vous avez enregistré est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove installazioni provano prima AetherEngine. L'ordine dei motori che hai salvato viene mantenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新規インストールでは最初にAetherEngineを使用します。保存済みのエンジンの順序はそのまま維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 설치하면 AetherEngine을 먼저 시도합니다. 저장해 둔 엔진 순서는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe installaties proberen eerst AetherEngine. Een engine-volgorde die je hebt bewaard, blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe instalacje najpierw próbują AetherEngine. Zapisana kolejność silników zostaje zachowana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novas instalações tentam primeiro o AetherEngine. A ordem de motores que você salvou é mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые установки сначала пробуют AetherEngine. Сохранённый вами порядок движков остаётся прежним."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kurulumlar önce AetherEngine'i dener. Kaydettiğiniz motor sırası korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新安装会优先尝试 AetherEngine。你保存的引擎顺序保持不变。"
          }
        }
      }
    },
    "whatsNew.3_3.guideDefault.summary" : {
      "comment" : "What’s New 3.3 highlight summary.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد ما يُعرض الآن فورًا. إذا كنت قد اخترت تخطيط القائمة من قبل، فسيحتفظ به Lume."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh sofort, was läuft. Wenn du zuvor das Listenlayout gewählt hast, behält Lume es bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See what’s on right away. If you chose the list layout before, Lume keeps it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta al instante qué están emitiendo. Si antes elegiste la vista de lista, Lume la conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez tout de suite ce qui passe. Si vous aviez choisi la présentation en liste, Lume la conserve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi subito cosa c'è in onda. Se avevi scelto il layout a elenco, Lume lo mantiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放送中の番組をすぐに確認できます。以前にリスト表示を選んでいた場合は、そのまま維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 방송 중인 프로그램을 바로 확인하세요. 이전에 목록 레이아웃을 선택했다면 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie meteen wat er te zien is. Als je eerder de lijstweergave koos, behoudt Lume die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od razu zobacz, co jest nadawane. Jeśli wcześniej wybrano układ listy, Lume go zachowa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja na hora o que está passando. Se você já tinha escolhido o layout de lista, o Lume o mantém."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сразу видно, что идёт в эфире. Если вы раньше выбрали вид списка, Lume его сохранит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayında ne olduğunu hemen görün. Daha önce liste düzenini seçtiyseniz Lume bunu korur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即查看正在播出的节目。如果你之前选择了列表布局，Lume 会保留它。"
          }
        }
      }
    },
