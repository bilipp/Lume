{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lume"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Permission prompt shown when Lume first looks for TVs, Cast devices or Philips Hue Bridges, or reaches a media server, WebDAV share or recording server, on the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Lume إلى الوصول إلى شبكتك المحلية للعثور على أجهزة التلفزيون وأجهزة Cast وجسور Philips Hue، وللوصول إلى خوادم الوسائط ومجلدات WebDAV المشتركة وخوادم التسجيل التي تعمل عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume benötigt Zugriff auf dein lokales Netzwerk, um Fernseher, Cast-Geräte und Philips Hue Bridges zu finden und darin laufende Medienserver, WebDAV-Freigaben und Aufnahmeserver zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume needs access to your local network to find TVs, Cast devices and Philips Hue Bridges, and to reach media servers, WebDAV shares and recording servers running on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume necesita acceso a tu red local para encontrar televisores, dispositivos Cast y puentes Philips Hue, y para conectarse a los servidores multimedia, recursos compartidos WebDAV y servidores de grabación que se ejecutan en ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume a besoin d’accéder à votre réseau local pour trouver les téléviseurs, les appareils Cast et les ponts Philips Hue, et pour atteindre les serveurs multimédias, les partages WebDAV et les serveurs d’enregistrement qui s’y trouvent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume ha bisogno di accedere alla rete locale per trovare TV, dispositivi Cast e bridge Philips Hue e per raggiungere i server multimediali, le condivisioni WebDAV e i server di registrazione presenti su di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume は、テレビ、Cast デバイス、Philips Hue Bridge を見つけたり、ローカルネットワーク上のメディアサーバー、WebDAV 共有、録画サーバーに接続したりするためにアクセス権が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume가 TV, Cast 기기 및 Philips Hue Bridge를 찾고 로컬 네트워크에서 실행 중인 미디어 서버, WebDAV 공유 및 녹화 서버에 연결하려면 접근 권한이 필요합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lume precisa de acesso à sua rede local para encontrar TVs, dispositivos Cast e bridges Philips Hue e para alcançar servidores de mídia, compartilhamentos WebDAV e servidores de gravação em execução nela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume 需要访问您的本地网络，以查找电视、Cast 设备和 Philips Hue Bridge，并连接其中运行的媒体服务器、WebDAV 共享和录制服务器。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}