          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편성표 URL을 비워 두면 재생목록에서 읽어 옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit veld leeg blijft, wordt de EPG-URL uit de playlist gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli pole pozostanie puste, URL EPG zostanie odczytany z playlisty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL do Guia de TV é lida da playlist quando deixada em branco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
