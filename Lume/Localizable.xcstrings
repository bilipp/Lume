    "Show a movie or series once when it's in several qualities, languages or playlists, and pick the version when you play it." : {
      "comment" : "Library settings footer for the Group Duplicate Titles toggle.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض الفيلم أو المسلسل مرة واحدة عندما يتوفر بعدة جودات أو لغات أو قوائم تشغيل، واختر النسخة عند تشغيله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen Film oder eine Serie nur einmal an, wenn es sie in mehreren Qualitäten, Sprachen oder Playlists gibt. Die Version wählst du beim Abspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a movie or series once when it's in several qualities, languages or playlists, and pick the version when you play it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una película o serie una sola vez cuando está en varias calidades, idiomas o listas, y elige la versión al reproducirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un film ou une série une seule fois lorsqu’il existe en plusieurs qualités, langues ou playlists, et choisissez la version au moment de la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un film o una serie una sola volta quando è disponibile in più qualità, lingue o playlist, e scegli la versione quando lo riproduci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の画質、言語、プレイリストにある映画やシリーズを1つにまとめて表示し、再生時にバージョンを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 화질, 언어 또는 재생목록에 있는 영화나 시리즈를 한 번만 표시하고, 재생할 때 버전을 선택합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon een film of serie maar één keer als die in meerdere kwaliteiten, talen of playlists beschikbaar is, en kies de versie wanneer je afspeelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj film lub serial tylko raz, gdy jest dostępny w kilku jakościach, językach lub playlistach, a wersję wybieraj przy odtwarzaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra um filme ou série uma única vez quando está em várias qualidades, idiomas ou playlists, e você escolhe a versão ao reproduzir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать фильм или сериал один раз, если он есть в нескольких качествах, на разных языках или в разных плейлистах. Версию можно выбрать при воспроизведении."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir film veya dizi birden fazla kalitede, dilde ya da oynatma listesinde varsa yalnızca bir kez gösterilir; sürümü oynatırken seçersiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当同一部电影或剧集有多种画质、语言或播放列表时只显示一次，播放时再选择版本。"
          }
        }
      }
    },
