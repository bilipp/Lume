          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nagrywania nie może teraz tego zrobić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de gravação não pode fazer isso agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер записи сейчас не может это выполнить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
