    "The Plex server rejected this token." : {
      "comment" : "Error message when a Plex token is refused.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plex-Server hat dieses Token abgelehnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor Plex rechazó este token."
          }
        },
