    "player.cast.error.load-failed" : {
      "comment" : "Player › Cast error: the Chromecast refused to load the stream; it now plays on the phone or tablet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على جهاز Cast فتحه، لذا يتم تشغيله على هذا الجهاز بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Cast-Gerät konnte ihn nicht öffnen, daher wird er jetzt auf diesem Gerät abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Cast device couldn't open it, so it's playing on this device instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo Cast no pudo abrirla, así que se está reproduciendo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil Cast n’a pas pu l’ouvrir ; la lecture se poursuit donc sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo Cast non è riuscito ad aprirlo, quindi viene riprodotto su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast デバイスで開けなかったため、このデバイスで再生しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast 기기에서 열 수 없어 이 기기에서 재생 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het Cast-apparaat kon de stream niet openen, dus wordt deze nu op dit apparaat afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie Cast nie mogło tego otworzyć, więc odtwarzanie trwa na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo Cast não conseguiu abri-lo, então ele está sendo reproduzido neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройству Cast не удалось открыть поток, поэтому он воспроизводится на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast aygıtı bunu açamadı, bu yüzden bu aygıtta oynatılıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast 设备无法打开此内容，因此改为在本设备上播放。"
          }
        }
      }
    },
    "player.cast.error.playback-failed" : {
      "comment" : "Player › Cast error: the Chromecast started the stream and then failed; it now plays on the phone or tablet.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التشغيل على جهاز Cast، لذا يتم تشغيله على هذا الجهاز بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiedergabe auf dem Cast-Gerät ist fehlgeschlagen, daher wird er jetzt auf diesem Gerät abgespielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback failed on the Cast device, so it's playing on this device instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción falló en el dispositivo Cast, así que se está reproduciendo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture a échoué sur l’appareil Cast ; elle se poursuit donc sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riproduzione sul dispositivo Cast non è riuscita, quindi viene riprodotto su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast デバイスでの再生に失敗したため、このデバイスで再生しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast 기기에서 재생에 실패하여 이 기기에서 재생 중입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het afspelen op het Cast-apparaat is mislukt, dus wordt de stream nu op dit apparaat afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzanie na urządzeniu Cast nie powiodło się, więc trwa ono na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reprodução falhou no dispositivo Cast, então ele está sendo reproduzido neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбой воспроизведения на устройстве Cast, поэтому поток воспроизводится на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast aygıtında oynatma başarısız oldu, bu yüzden bu aygıtta oynatılıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Cast 设备上播放失败，因此改为在本设备上播放。"
          }
        }
      }
    },
