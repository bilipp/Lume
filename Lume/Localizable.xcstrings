          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Lume on your other devices so they keep syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Lume en tus otros dispositivos para que sigan sincronizándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Lume sur vos autres appareils pour qu’ils continuent de se synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Lume sugli altri tuoi dispositivi perché continuino a sincronizzarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を続けるには、ほかのデバイスのLumeもアップデートしてください。"
