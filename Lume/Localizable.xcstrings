    "Sync watched movies and episodes, show your Trakt watchlist on Home, and download subtitles for anything that ships without them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere gesehene Filme und Episoden, zeige deine Trakt-Watchlist auf dem Startbildschirm und lade Untertitel für alles herunter, was ohne sie ausgeliefert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
