    "The recording server can't do that right now." : {
      "comment" : "Recording server error: generic conflict.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لخادم التسجيل تنفيذ ذلك الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aufnahmeserver kann das gerade nicht ausführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording server can't do that right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de grabación no puede hacerlo ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
