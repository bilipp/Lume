    "Autoplay the next episode, skip intros, and jump ahead with one tap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل الحلقة التالية تلقائيًا، وتخطَّ المقدمات، وتقدّم بنقرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele die nächste Folge automatisch ab, überspringe Intros und springe mit einem Tippen voraus."
          }
        },
        "es" : {
          "stringUnit" : {
