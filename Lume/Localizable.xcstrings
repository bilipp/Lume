    "Pinch and hold Play to pick a source at any time." : {
      "comment" : "visionOS player settings hint: a pinch and hold on a movie or series Play button opens the source picker.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرص مطولًا على \"تشغيل\" لاختيار مصدر في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte „Abspielen“ per Fingertipp gedrückt, um jederzeit eine Quelle zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch and hold Play to pick a source at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca y mantén Reproducir para elegir una fuente en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez et maintenez Lecture pour choisir une source à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica e tieni premuto Riproduci per scegliere una fonte in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再生」をピンチしたままにすると、いつでもソースを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생을 길게 핀치하면 언제든지 소스를 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp en houd vast op “Speel af” om op elk moment een bron te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj przycisk Odtwórz uszczypnięciem, aby w każdej chwili wybrać źródło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belisque e mantenha Reproduzir para escolher uma fonte a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы в любой момент выбрать источник, сведите пальцы на кнопке «Воспроизвести» и удерживайте их."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman bir kaynak seçmek için Oynat'a çimdikleyip basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捏住“播放”不放，可随时选择来源。"
          }
        }
      }
    },
