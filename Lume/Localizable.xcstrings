    "Select a row to lift it, then move up or down and select again to place — the first few lead the Home shelf." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Zeile aus, um sie anzuheben, bewege sie nach oben oder unten und wähle erneut, um sie zu platzieren – die ersten stehen im Home-Regal vorn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una fila para levantarla, muévela arriba o abajo y vuelve a seleccionarla para colocarla: las primeras encabezan la fila de Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez une ligne pour la soulever, déplacez-la vers le haut ou le bas, puis sélectionnez-la de nouveau pour la placer — les premières ouvrent la rangée d'accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona una riga per sollevarla, spostala su o giù e selezionala di nuovo per posizionarla: le prime guidano la fila della Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行を選択して持ち上げ、上下に移動してもう一度選択すると配置できます。先頭の項目がホームの棚の先頭に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행을 선택해 들어 올린 다음 위아래로 이동하고 다시 선택하여 배치하세요. 앞쪽 항목이 홈 화면 줄의 맨 앞에 표시됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione uma linha para levantá-la, mova para cima ou para baixo e selecione novamente para posicioná-la — as primeiras lideram a fileira da Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一行将其拿起，上下移动后再次选择即可放置 — 靠前的几项会显示在主页栏目的最前面。"
          }
        }
      }
    },
