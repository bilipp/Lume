            "value" : "아래에서 리그와 팀을 팔로우하여 스포츠 허브를 구성하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg hieronder competities en teams om je Sporthub op te bouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwuj poniższe ligi i drużyny, aby zbudować swoje Centrum sportu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga ligas e times abaixo para montar sua Central de Esportes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишитесь на лиги и команды ниже, чтобы настроить спортивный раздел."
