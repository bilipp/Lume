    "Get an on-device \"For You\" row tuned to your taste from your library and what you watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على صف «لك» على الجهاز نفسه، مصمَّم وفق ذوقك بناءً على مكتبتك وما تشاهده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte direkt auf dem Gerät eine auf deinen Geschmack abgestimmte „Für dich“-Reihe – aus deiner Mediathek und deinem Sehverhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén una fila «Para ti» en el dispositivo, adaptada a tus gustos a partir de tu biblioteca y de lo que ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez une rangée « Pour vous » générée sur l’appareil et adaptée à vos goûts, à partir de votre bibliothèque et de ce que vous regardez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni una riga \"Per te\" sul dispositivo, su misura per i tuoi gusti, basata sulla tua libreria e su ciò che guardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリと視聴履歴から、あなたの好みに合わせたオンデバイスの「For You」の行を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리와 시청 내역을 바탕으로 취향에 맞춰진 기기 내 \"추천\" 항목을 받아보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg op het apparaat zelf een rij ‘Voor jou’ die is afgestemd op je smaak, op basis van je bibliotheek en wat je kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymuj tworzony na urządzeniu rząd „Dla Ciebie” dopasowany do Twojego gustu – na podstawie biblioteki i tego, co oglądasz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenha uma linha \"Para Você\" no dispositivo, ajustada ao seu gosto com base na sua biblioteca e no que você assiste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте ряд «Для вас», подобранный на устройстве по вашим вкусам — на основе медиатеки и просмотренного."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arşivinize ve izlediklerinize göre zevkinize uygun, aygıt üzerinde oluşturulan bir \"Sizin İçin\" satırı edinin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据您的媒体库和观看内容，获得一个在设备上为您量身定制的“为你推荐”栏。"
          }
        }
      }
    },
    "Get help, request a feature, or report a problem." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على المساعدة، أو اطلب ميزة، أو أبلغ عن مشكلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte Hilfe, wünsche dir eine Funktion oder melde ein Problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén ayuda, solicita una función o informa de un problema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez de l’aide, demandez une fonctionnalité ou signalez un problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni assistenza, richiedi una funzione o segnala un problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルプを受けたり、機能をリクエストしたり、問題を報告したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도움을 받거나, 기능을 요청하거나, 문제를 신고하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg hulp, vraag een functie aan of meld een probleem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzyskaj pomoc, zaproponuj funkcję lub zgłoś problem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenha ajuda, solicite um recurso ou relate um problema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получите помощь, предложите функцию или сообщите о проблеме."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yardım alın, özellik isteyin veya sorun bildirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取帮助、请求功能或报告问题。"
          }
        }
      }
    },
    "Give everyone their own watch history, progress and favorites." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح كل فرد سجل مشاهدة وتقدّمًا ومفضلة خاصة به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib jedem seinen eigenen Verlauf, Fortschritt und Favoriten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a cada persona su propio historial de visualización, progreso y favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offrez à chacun son propre historique de visionnage, sa progression et ses favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offri a ciascuno la propria cronologia di visione, i propri progressi e i propri preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全員に独自の視聴履歴、進行状況、お気に入りを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두에게 고유한 시청 기록, 진행 상황, 즐겨찾기를 제공하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef iedereen een eigen kijkgeschiedenis, voortgang en favorieten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy może mieć własną historię oglądania, postępy i ulubione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê a cada pessoa seu próprio histórico, progresso e favoritos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Своя история просмотра, прогресс и избранное для каждого."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkese kendi izleme geçmişini, ilerlemesini ve favorilerini verin."
