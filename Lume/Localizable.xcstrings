          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso e o status de assistido de todos os títulos serão removidos. Isso não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс просмотра и отметки о просмотре всех материалов будут удалены. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
