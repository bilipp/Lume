    "premium.hueSync.subtitle" : {
      "comment" : "Lume Pro feature description: Hue lights synced to the picture during playback on Apple TV.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل مصابيح منطقة الترفيه في Philips Hue تتبع ألوان ما تشاهده على Apple TV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Lampen eines Philips Hue Entertainment-Bereichs den Farben dessen folgen, was du auf dem Apple TV schaust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let the lamps of a Philips Hue entertainment area follow the colours of what you watch on Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que las luces de un área de entretenimiento de Philips Hue sigan los colores de lo que ves en el Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lampes d’une zone de divertissement Philips Hue suivent les couleurs de ce que vous regardez sur l’Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai seguire alle luci di un’area di intrattenimento Philips Hue i colori di ciò che guardi su Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Philips Hue のエンターテイメントエリアのライトを、Apple TV で観ている映像の色に合わせて変化させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Philips Hue 엔터테인먼트 영역의 조명이 Apple TV에서 시청 중인 화면의 색상을 따라 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de lampen van een Philips Hue-entertainmentruimte de kleuren volgen van wat je op Apple TV kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lampy strefy rozrywki Philips Hue podążają za kolorami tego, co oglądasz na Apple TV."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça as luzes de uma área de entretenimento Philips Hue acompanharem as cores do que você assiste na Apple TV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лампы развлекательной зоны Philips Hue будут повторять цвета того, что вы смотрите на Apple TV."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Philips Hue eğlence alanındaki lambaların, Apple TV'de izlediğiniz içeriğin renklerini izlemesini sağlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Philips Hue 娱乐区域的灯光跟随你在 Apple TV 上观看内容的色彩变化。"
          }
        }
      }
    },
