          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите URL портала и MAC-адрес, авторизованный вашим провайдером. Большинству порталов нужны только URL портала и MAC-адрес."
          }
        },
