    "Press and hold Play to pick a source at any time." : {
      "comment" : "tvOS player settings hint: holding the remote's select button on a movie or series Play button opens the source picker.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على \"تشغيل\" لاختيار مصدر في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte „Abspielen“ gedrückt, um jederzeit eine Quelle zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold Play to pick a source at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado Reproducir para elegir una fuente en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez Lecture enfoncé pour choisir une source à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Riproduci per scegliere una fonte in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再生」を長押しすると、いつでもソースを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생을 길게 누르면 언제든지 소스를 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd 'Speel af' ingedrukt om op elk moment een bron te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj przycisk Odtwórz, aby w każdej chwili wybrać źródło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha Reproduzir pressionado para escolher uma fonte a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы в любой момент выбрать источник, нажмите и удерживайте кнопку «Воспроизвести»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman bir kaynak seçmek için Oynat'ı basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住“播放”可随时选择来源。"
          }
        }
      }
    },
