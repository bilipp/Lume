    "Change or cancel in Settings ▸ Users & Accounts ▸ your Apple Account ▸ Subscriptions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك التغيير أو الإلغاء من الإعدادات ▸ المستخدمون والحسابات ▸ حساب Apple ▸ الاشتراكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändern oder kündigen unter Einstellungen ▸ Benutzer & Accounts ▸ Apple-Account ▸ Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia o cancela en Ajustes ▸ Usuarios y cuentas ▸ tu cuenta de Apple ▸ Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez ou résiliez dans Réglages ▸ Utilisateurs et comptes ▸ votre compte Apple ▸ Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica o disdici in Impostazioni ▸ Utenti e account ▸ il tuo account Apple ▸ Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 ▸ ユーザとアカウント ▸ Apple アカウント ▸ サブスクリプション で変更または解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 ▸ 사용자 및 계정 ▸ Apple 계정 ▸ 구독에서 변경하거나 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig of zeg op via Instellingen ▸ Gebruikers en accounts ▸ je Apple Account ▸ Abonnementen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień lub anuluj w Ustawienia ▸ Użytkownicy i konta ▸ Twoje konto Apple ▸ Subskrypcje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altere ou cancele em Ajustes ▸ Usuários e Contas ▸ sua conta Apple ▸ Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменить или отменить можно в меню «Настройки» ▸ «Пользователи и аккаунты» ▸ ваш Аккаунт Apple ▸ «Подписки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar ▸ Kullanıcılar ve Hesaplar ▸ Apple Hesabınız ▸ Abonelikler bölümünden değiştirin veya iptal edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置” ▸ “用户与账户” ▸ Apple 账户 ▸ “订阅”中更改或取消。"
