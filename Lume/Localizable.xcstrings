    "“%@” and its video are deleted from your Dispatcharr server." : {
      "comment" : "Confirmation message before deleting a recording on a Dispatcharr server. %@ is the recording title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف “%@” والفيديو الخاص به من خادم Dispatcharr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und das zugehörige Video werden von deinem Dispatcharr-Server gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its video are deleted from your Dispatcharr server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y su vídeo se eliminarán de tu servidor Dispatcharr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et sa vidéo seront supprimés de votre serveur Dispatcharr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» e il relativo video verranno eliminati dal tuo server Dispatcharr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とその動画が Dispatcharr サーバーから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 및 해당 동영상이 Dispatcharr 서버에서 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” en de bijbehorende video worden van je Dispatcharr-server verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” wraz z nagraniem wideo zostanie usunięte z Twojego serwera Dispatcharr."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e o vídeo serão apagados do seu servidor Dispatcharr."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и его видео будут удалены с вашего сервера Dispatcharr."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve videosu Dispatcharr sunucunuzdan silinecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其视频将从您的 Dispatcharr 服务器中删除。"
          }
        }
      }
    },
    "“%@” and its video are removed from the recording server for all your devices." : {
      "comment" : "Confirmation message before deleting a recording. %@ is the recording title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة “%@” والفيديو الخاص به من خادم التسجيل على جميع أجهزتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und das zugehörige Video werden für alle deine Geräte vom Aufnahmeserver entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its video are removed from the recording server for all your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” y su vídeo se eliminarán del servidor de grabación en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et sa vidéo seront supprimés du serveur d’enregistrement pour tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e il relativo video verranno rimossi dal server di registrazione per tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とその動画は、すべてのデバイスで録画サーバーから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 및 해당 동영상이 모든 기기에서 녹화 서버에서 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” en de bijbehorende video worden voor al je apparaten van de opnameserver verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” wraz z nagraniem wideo zostanie usunięte z serwera nagrań na wszystkich Twoich urządzeniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e seu vídeo serão removidos do servidor de gravação em todos os seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и его видео будут удалены с сервера записи для всех ваших устройств."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve videosu, tüm aygıtlarınız için kayıt sunucusundan kaldırılacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其视频将从录制服务器中移除，所有设备均会生效。"
          }
        }
      }
    },
    "“%@” stops recording now. What's been recorded so far is kept." : {
      "comment" : "Confirmation message before stopping a recording. %@ is the recording title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف تسجيل “%@” الآن. سيتم الاحتفاظ بما تم تسجيله حتى الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme von „%@“ wird jetzt beendet. Das bisher Aufgenommene bleibt erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” stops recording now. What's been recorded so far is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dejará de grabarse ahora. Lo grabado hasta el momento se conserva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de « %@ » s’arrête maintenant. Ce qui a déjà été enregistré est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione di “%@” si interrompe ora. Quanto registrato finora viene conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の録画を今すぐ停止します。ここまでに録画された部分は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 녹화를 지금 중지합니다. 지금까지 녹화된 내용은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname van “%@” stopt nu. Wat tot nu toe is opgenomen, blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie „%@” zostanie teraz zatrzymane. Dotychczas nagrany materiał zostanie zachowany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de “%@” será interrompida agora. O que já foi gravado será mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись «%@» будет остановлена. Уже записанное сохранится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kaydı şimdi durdurulacak. Şu ana kadar kaydedilenler korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将立即停止录制。已录制的内容会保留。"
          }
        }
      }
    },
    "“%@” stops recording, and what's been recorded so far is deleted from your Dispatcharr server." : {
      "comment" : "Confirmation message before deleting a recording that is still running on a Dispatcharr server. %@ is the recording title.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف تسجيل “%@”، وسيتم حذف ما تم تسجيله حتى الآن من خادم Dispatcharr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme von „%@“ wird beendet und das bisher Aufgenommene von deinem Dispatcharr-Server gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” stops recording, and what's been recorded so far is deleted from your Dispatcharr server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» dejará de grabarse y lo grabado hasta ahora se eliminará de tu servidor Dispatcharr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement de « %@ » s’arrête, et ce qui a déjà été enregistré est supprimé de votre serveur Dispatcharr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione di «%@» si interrompe e quanto registrato finora verrà eliminato dal tuo server Dispatcharr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の録画を停止し、ここまでに録画された部分を Dispatcharr サーバーから削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ 녹화가 중지되고, 지금까지 녹화된 내용은 Dispatcharr 서버에서 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname van “%@” stopt en wat tot nu toe is opgenomen, wordt van je Dispatcharr-server verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie „%@” zostanie zatrzymane, a dotychczas nagrany materiał usunięty z Twojego serwera Dispatcharr."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de “%@” será interrompida e o que já foi gravado será apagado do seu servidor Dispatcharr."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись «%@» будет остановлена, а уже записанное — удалено с вашего сервера Dispatcharr."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” kaydı durdurulacak ve şu ana kadar kaydedilenler Dispatcharr sunucunuzdan silinecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将停止录制，已录制的内容将从您的 Dispatcharr 服务器中删除。"
          }
        }
      }
    },
