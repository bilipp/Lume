            "value" : "Accedi con"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン方法"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 방법"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się przez"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrar com"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Способ входа"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş Yöntemi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录方式"
          }
        }
      }
    },
    "Sign in with your free opensubtitles.com account to download subtitles for movies and episodes from the player's subtitle menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بحسابك المجاني في opensubtitles.com لتنزيل ترجمة الأفلام والحلقات من قائمة الترجمة في المشغّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit deinem kostenlosen opensubtitles.com-Konto an, um Untertitel für Filme und Episoden direkt aus dem Untertitelmenü des Players herunterzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta gratuita de opensubtitles.com para descargar subtítulos de películas y episodios desde el menú de subtítulos del reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte gratuit opensubtitles.com pour télécharger des sous-titres de films et d’épisodes depuis le menu des sous-titres du lecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account gratuito opensubtitles.com per scaricare i sottotitoli di film ed episodi dal menu dei sottotitoli del player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料のopensubtitles.comアカウントでサインインすると、プレーヤーの字幕メニューから映画やエピソードの字幕をダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 opensubtitles.com 계정으로 로그인하면 플레이어의 자막 메뉴에서 영화와 에피소드 자막을 다운로드할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met je gratis opensubtitles.com-account om ondertitels voor films en afleveringen te downloaden via het ondertitelmenu van de speler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się bezpłatnym kontem opensubtitles.com, aby pobierać napisy do filmów i odcinków z menu napisów odtwarzacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com sua conta gratuita do opensubtitles.com para baixar legendas de filmes e episódios no menu de legendas do player."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с бесплатной учетной записью opensubtitles.com, чтобы загружать субтитры к фильмам и эпизодам прямо из меню субтитров плеера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatıcının altyazı menüsünden filmler ve bölümler için altyazı indirmek üzere ücretsiz opensubtitles.com hesabınızla giriş yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用免费的 opensubtitles.com 账户登录，即可在播放器的字幕菜单中下载电影和剧集的字幕。"
          }
        }
      }
    },
    "Sign in with your free opensubtitles.com account to download subtitles. Searching works without one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بحسابك المجاني في opensubtitles.com لتنزيل الترجمة. البحث يعمل بدونه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit deinem kostenlosen opensubtitles.com-Konto an, um Untertitel herunterzuladen. Die Suche funktioniert auch ohne Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta gratuita de opensubtitles.com para descargar subtítulos. La búsqueda funciona sin cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte gratuit opensubtitles.com pour télécharger des sous-titres. La recherche fonctionne sans compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account gratuito opensubtitles.com per scaricare i sottotitoli. La ricerca funziona anche senza account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕をダウンロードするには、無料のopensubtitles.comアカウントでサインインしてください。検索はアカウントなしでも利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막을 다운로드하려면 무료 opensubtitles.com 계정으로 로그인하세요. 검색은 계정 없이도 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met je gratis opensubtitles.com-account om ondertitels te downloaden. Zoeken werkt ook zonder account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się bezpłatnym kontem opensubtitles.com, aby pobierać napisy. Wyszukiwanie działa bez konta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com sua conta gratuita do opensubtitles.com para baixar legendas. A busca funciona sem conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с бесплатной учетной записью opensubtitles.com, чтобы загружать субтитры. Поиск работает и без нее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazı indirmek için ücretsiz opensubtitles.com hesabınızla giriş yapın. Arama, hesap olmadan da çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用免费的 opensubtitles.com 账户登录以下载字幕。搜索无需账户即可使用。"
          }
        }
      }
    },
