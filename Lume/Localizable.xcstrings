          "stringUnit" : {
            "state" : "translated",
            "value" : "Un décalage audio positif diffuse le son plus tard. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ritardo audio positivo riproduce il suono più tardi. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオ遅延を正の値にすると、音声が遅れて再生されます。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오 지연을 양수로 설정하면 소리가 더 늦게 재생됩니다. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
