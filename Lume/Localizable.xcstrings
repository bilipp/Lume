    "Movies, Series and Live TV apply to %@, your active playlist. Sports applies to every playlist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الأفلام والمسلسلات والبث المباشر على %@، قائمة التشغيل النشطة. وتنطبق الرياضة على كل قوائم التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filme, Serien und Live-TV gelten für %@, deine aktive Playlist. Sport gilt für alle Playlists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Películas, Series y TV en directo se aplican a %@, tu lista activa. Deportes se aplica a todas las listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films, Séries et TV en direct s’appliquent à %@, votre playlist active. Sport s’applique à toutes les playlists."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film, Serie e TV in diretta valgono per %@, la playlist attiva. Sport vale per tutte le playlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画、シリーズ、ライブTVはアクティブなプレイリスト「%@」に適用されます。スポーツはすべてのプレイリストに適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화, 시리즈, 라이브 TV는 현재 재생 목록인 %@에 적용됩니다. 스포츠는 모든 재생 목록에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Films, Series en Live tv gelden voor %@, je actieve playlist. Sport geldt voor alle playlists."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmy, seriale i TV na żywo dotyczą aktywnej playlisty: %@. Sport dotyczy wszystkich playlist."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes, Séries e TV ao vivo se aplicam a %@, sua playlist ativa. Esportes se aplica a todas as playlists."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фильмы, сериалы и ТВ относятся к %@ — вашему активному плейлисту. «Спорт» действует для всех плейлистов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmler, Diziler ve Canlı TV, etkin oynatma listeniz için geçerlidir: %@. Spor tüm oynatma listeleri için geçerlidir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电影、剧集和直播电视仅适用于当前播放列表“%@”。体育适用于所有播放列表。"
          }
        }
      }
    },
