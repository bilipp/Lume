    "Follow leagues and teams below to build your Sports Hub." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابِع الدوريات والفرق أدناه لإنشاء مركزك الرياضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folge unten Ligen und Teams, um deinen Sport-Hub einzurichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue ligas y equipos abajo para crear tu Centro de deportes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez des ligues et des équipes ci-dessous pour composer votre espace sports."
