          "stringUnit" : {
            "state" : "translated",
            "value" : "브리지를 찾으려면 Lume에 로컬 네트워크 접근 권한이 필요합니다. 설정 › 앱 › Lume에서 허용하거나 브리지의 IP 주소를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume heeft toegang tot het lokale netwerk nodig om de bridge te vinden. Sta dit toe via Instellingen › Apps › Lume, of voer het IP-adres van de bridge in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume potrzebuje dostępu do sieci lokalnej, aby znaleźć mostek. Zezwól na niego w Ustawienia › Aplikacje › Lume lub wprowadź adres IP mostka."
          }
