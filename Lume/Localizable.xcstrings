    "Switching playlist changes the content shown across Home, Movies, Series and Live TV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تبديل قائمة التشغيل إلى تغيير المحتوى المعروض في الرئيسية والأفلام والمسلسلات والبث المباشر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel der Playlist ändern sich die Inhalte in Start, Filme, Serien und Live-TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar de lista de reproducción modifica el contenido que se muestra en Inicio, Películas, Series y TV en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de playlist modifie le contenu affiché dans Accueil, Films, Séries et TV en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare playlist modifica i contenuti mostrati in Home, Film, Serie e TV in diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストを切り替えると、ホーム、映画、シリーズ、ライブTV全体に表示されるコンテンツが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록을 전환하면 홈, 영화, 시리즈, 라이브 TV 전반에 표시되는 콘텐츠가 변경됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je van playlist wisselt, verandert de content in Thuis, Films, Series en Live-tv."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana playlisty zmienia treści na ekranie głównym oraz w sekcjach Filmy, Seriale i TV na żywo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trocar de playlist altera o conteúdo mostrado em Início, Filmes, Séries e TV ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При смене плейлиста меняется контент на главном экране и в разделах «Фильмы», «Сериалы» и «Эфир»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oynatma listesini değiştirmek Ana Sayfa, Filmler, Diziler ve Canlı TV'de gösterilen içeriği değiştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换播放列表会更改主页、电影、剧集和直播电视中显示的内容。"
          }
        }
      }
    },
