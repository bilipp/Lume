    "Update Lume on your other devices so they keep syncing." : {
      "comment" : "Message of the one-time 'Sync moved to Lume Cloud' alert.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث Lume على أجهزتك الأخرى لتواصل المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
