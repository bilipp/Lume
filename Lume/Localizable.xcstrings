    "Hide categories to remove them from Live TV, or tap a category to manage its channels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخفِ الفئات لإزالتها من البث المباشر، أو اضغط على فئة لإدارة قنواتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blende Kategorien aus, um sie aus Live-TV zu entfernen, oder tippe auf eine Kategorie, um ihre Sender zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta categorías para quitarlas de TV en directo, o toca una categoría para gestionar sus canales."
