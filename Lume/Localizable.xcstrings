            "value" : "自動"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático"
          }
        },
        "zh-Hans" : {
