    "Browse Live TV, Movies and Series from several playlists together." : {
      "comment" : "Footer under the Combined View row in Playlists settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفّح البث المباشر والأفلام والمسلسلات من عدة قوائم تشغيل معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-TV, Filme und Serien aus mehreren Playlists gemeinsam durchsuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse Live TV, Movies and Series from several playlists together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora TV en directo, películas y series de varias listas a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez la TV en direct, les films et les séries de plusieurs playlists à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoglia TV in diretta, film e serie da più playlist insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のプレイリストのライブTV、映画、シリーズをまとめて閲覧できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 재생목록의 라이브 TV, 영화, 시리즈를 한곳에서 둘러봅니다."
          }
        },
        "nl" : {
