    "settings.hue.pairing.instructions" : {
      "comment" : "Philips Hue pairing step: how to authorise Lume with the bridge's link button (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط زر الربط الدائري أعلى جسر Hue، ثم اختر «اقتران» خلال 30 ثانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke die runde Link-Taste oben auf der Hue Bridge und wähle dann innerhalb von 30 Sekunden „Koppeln“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press the round link button on top of the Hue Bridge, then select Pair within 30 seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el botón de enlace redondo de la parte superior del puente Hue y selecciona Vincular en menos de 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le bouton de liaison rond sur le dessus du pont Hue, puis sélectionnez Jumeler dans les 30 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi il pulsante di collegamento rotondo sulla parte superiore del bridge Hue, quindi seleziona Abbina entro 30 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue ブリッジ上部の丸いリンクボタンを押してから、30 秒以内に「ペアリング」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue 브리지 상단의 둥근 링크 버튼을 누른 다음 30초 이내에 페어링을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op de ronde linkknop boven op de Hue Bridge en selecteer binnen 30 seconden “Koppel”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij okrągły przycisk łączenia na górze mostka Hue, a następnie w ciągu 30 sekund wybierz „Sparuj”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione o botão de link redondo na parte de cima da bridge Hue e selecione Parear em até 30 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите круглую кнопку связи сверху на мосте Hue, а затем в течение 30 секунд выберите «Создать пару»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hue Bridge'in üstündeki yuvarlak bağlantı düğmesine basın, ardından 30 saniye içinde Eşle'yi seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 Hue 桥接器顶部的圆形链接按钮，然后在 30 秒内选择“配对”。"
          }
        }
      }
    },
