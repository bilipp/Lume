          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem bu profilin izleme geçmişini, ilerlemesini ve favorilerini kalıcı olarak siler. Arşiviniz etkilenmez."
