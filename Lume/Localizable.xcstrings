    "Your account on the recording server isn't allowed to do that." : {
      "comment" : "Recording server error: the signed-in account lacks permission (for example a view-only DVR account trying to record, stop or delete).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسابك على خادم التسجيل غير مسموح له بذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto auf dem Aufnahmeserver darf das nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account on the recording server isn't allowed to do that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta en el servidor de grabación no tiene permiso para hacer eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte sur le serveur d’enregistrement n’est pas autorisé à faire cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account sul server di registrazione non è autorizzato a farlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画サーバーのあなたのアカウントには、この操作を行う権限がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 서버의 계정에 이 작업을 수행할 권한이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account op de opnameserver mag dat niet doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto na serwerze nagrywania nie ma uprawnień do tej czynności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta no servidor de gravação não tem permissão para fazer isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашей учетной записи на сервере записи это не разрешено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt sunucusundaki hesabınızın bunu yapma izni yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在录制服务器上的账户无权执行此操作。"
          }
        }
      }
    },
    "Your Apple devices go back to iCloud. Your Lume Cloud account and its data stay, so you can rejoin later." : {
      "comment" : "Leave Lume Cloud confirmation: what happens when leaving returns the user’s Apple devices to iCloud.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود أجهزتك من Apple إلى iCloud. يبقى حساب Lume Cloud وبياناته، لذا يمكنك الانضمام مجددًا لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apple-Geräte wechseln zurück zu iCloud. Dein Lume Cloud-Account und seine Daten bleiben erhalten, sodass du später wieder beitreten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple devices go back to iCloud. Your Lume Cloud account and its data stay, so you can rejoin later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus dispositivos Apple vuelven a iCloud. Tu cuenta de Lume Cloud y sus datos se conservan, así que puedes volver a unirte más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos appareils Apple repassent à iCloud. Votre compte Lume Cloud et ses données sont conservés : vous pourrez le rejoindre plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dispositivi Apple tornano a iCloud. Il tuo account Lume Cloud e i relativi dati restano, quindi potrai unirti di nuovo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いのAppleデバイスはiCloudに戻ります。Lume Cloudアカウントとそのデータは残るため、あとで再参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 기기는 iCloud로 돌아갑니다. Lume Cloud 계정과 데이터는 유지되므로 나중에 다시 참여할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Apple-apparaten gaan terug naar iCloud. Je Lume Cloud-account en de gegevens ervan blijven bewaard, zodat je later weer kunt meedoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje urządzenia Apple wrócą do iCloud. Konto Lume Cloud i jego dane pozostaną, więc możesz później ponownie dołączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dispositivos Apple voltam para o iCloud. Sua conta do Lume Cloud e os dados dela continuam, então você pode entrar novamente depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши устройства Apple вернутся к iCloud. Учетная запись Lume Cloud и ее данные сохранятся, так что позже можно будет подключиться снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple aygıtlarınız iCloud'a geri döner. Lume Cloud hesabınız ve verileri korunur; böylece daha sonra yeniden katılabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
