    "Scrobble what you watch to Trakt, Simkl or MDBList, import your history and surface your watchlist on Home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل ما تشاهده في Trakt أو Simkl أو MDBList، واستورد سجلّك، واعرض قائمة مشاهدتك في الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertrage, was du ansiehst, an Trakt, Simkl oder MDBList, importiere deinen Verlauf und zeige deine Watchlist auf der Startseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra lo que ves en Trakt, Simkl o MDBList, importa tu historial y muestra tu lista de seguimiento en Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobblez ce que vous regardez vers Trakt, Simkl ou MDBList, importez votre historique et affichez votre liste de suivi sur l’écran d’accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui lo scrobble di ciò che guardi su Trakt, Simkl o MDBList, importa la tua cronologia e mostra la tua watchlist nella Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴した内容をTrakt、Simkl、またはMDBListにスクロブルし、履歴をインポートして、ウォッチリストをホームに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청 내역을 Trakt, Simkl 또는 MDBList에 스크로블하고, 기록을 가져오며, 홈에 시청 목록을 표시하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobble wat je kijkt naar Trakt, Simkl of MDBList, importeer je geschiedenis en toon je kijklijst in Thuis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj informacje o tym, co oglądasz, do Trakt, Simkl lub MDBList, importuj historię i wyświetlaj listę do obejrzenia na ekranie głównym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça scrobble do que você assiste no Trakt, no Simkl ou no MDBList, importe seu histórico e mostre sua lista na Tela Inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте историю просмотра в Trakt, Simkl или MDBList, импортируйте историю и выводите список «Буду смотреть» на главный экран."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlediklerinizi Trakt, Simkl veya MDBList'e scrobble edin, geçmişinizi içe aktarın ve izleme listenizi Ana Sayfa'da gösterin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将您观看的内容记录到Trakt、Simkl或MDBList，导入您的历史记录，并在主页上展示您的待看列表。"
          }
        }
      }
    },
