    "This account already exists. Join with a code or your recovery key instead." : {
      "comment" : "Error when creating a Lume Cloud account whose id already exists on the server.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الحساب موجود بالفعل. انضم باستخدام رمز أو بمفتاح الاسترداد بدلاً من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
