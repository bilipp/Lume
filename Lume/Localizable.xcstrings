    "Everything currently listed will be hidden from browsing. Use Show All to bring it back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إخفاء كل ما هو معروض حاليًا من التصفح. استخدم «عرض الكل» لاستعادته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was aktuell aufgelistet ist, wird beim Stöbern ausgeblendet. Mit „Alle anzeigen“ holst du es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que aparece en la lista se ocultará de la navegación. Usa «Mostrar todo» para recuperarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui figure actuellement dans la liste sera masqué lors de la navigation. Utilisez « Tout afficher » pour le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che è attualmente elencato verrà nascosto dalla navigazione. Usa \"Mostra tutto\" per ripristinarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在リストに表示されているものはすべて閲覧時に非表示になります。「すべて表示」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 목록에 있는 모든 항목이 둘러보기에서 숨겨집니다. 모두 보기로 다시 표시할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles wat nu in de lijst staat, wordt verborgen bij het bladeren. Gebruik ‘Toon alles’ om het terug te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko, co jest teraz na liście, zostanie ukryte podczas przeglądania. Użyj opcji Pokaż wszystko, aby to przywrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que está listado no momento será ocultado da navegação. Use \"Mostrar Tudo\" para trazê-lo de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все, что сейчас в списке, будет скрыто при просмотре. Вернуть можно кнопкой «Показать все»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda listelenen her şey göz atma sırasında gizlenecek. Geri getirmek için Tümünü Göster'i kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前列出的所有内容都将在浏览时隐藏。使用“显示全部”可恢复。"
          }
        }
      }
    },
    "Everything stays on this device." : {
      "comment" : "Detail under the Don’t Sync option of the first-run sync choice.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى كل شيء على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf diesem Gerät."
