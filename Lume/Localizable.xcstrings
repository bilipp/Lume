        }
      }
    },
    "The recording server didn't accept these sign-in details. Check them and try again." : {
      "comment" : "Recording server sign-in error: Dispatcharr rejected the API key or the username and password.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل خادم التسجيل بيانات تسجيل الدخول هذه. تحقّق منها وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aufnahmeserver hat diese Anmeldedaten nicht akzeptiert. Überprüfe sie und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording server didn't accept these sign-in details. Check them and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de grabación no ha aceptado estos datos de inicio de sesión. Revísalos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur d’enregistrement n’a pas accepté ces identifiants. Vérifiez-les et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di registrazione non ha accettato questi dati di accesso. Controllali e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画サーバーがこのサインイン情報を受け付けませんでした。内容を確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 서버가 이 로그인 정보를 허용하지 않았습니다. 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opnameserver heeft deze inloggegevens niet geaccepteerd. Controleer ze en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nagrywania nie zaakceptował tych danych logowania. Sprawdź je i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de gravação não aceitou esses dados de acesso. Verifique-os e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер записи не принял эти данные для входа. Проверьте их и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt sunucusu bu giriş bilgilerini kabul etmedi. Kontrol edip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制服务器未接受这些登录信息。请检查后重试。"
          }
        }
      }
    },
    "The recording server is already recording as many streams as it allows. Stop another recording and try again." : {
      "comment" : "Recording server error: concurrent-recording limit reached.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل خادم التسجيل بالفعل الحد الأقصى المسموح به من البثوث. أوقف تسجيلًا آخر وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aufnahmeserver nimmt bereits so viele Streams auf, wie er zulässt. Beende eine andere Aufnahme und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording server is already recording as many streams as it allows. Stop another recording and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de grabación ya está grabando el máximo de streams permitido. Detén otra grabación e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur d’enregistrement enregistre déjà le nombre maximal de flux autorisé. Arrêtez un autre enregistrement et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di registrazione sta già registrando il numero massimo di flussi consentiti. Interrompi un’altra registrazione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画サーバーは許可されている最大数のストリームをすでに録画しています。他の録画を停止してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 서버가 이미 허용된 최대 수의 스트림을 녹화하고 있습니다. 다른 녹화를 중지한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opnameserver neemt al zoveel streams op als toegestaan. Stop een andere opname en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nagrywania nagrywa już maksymalną dozwoloną liczbę strumieni. Zatrzymaj inne nagrywanie i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de gravação já está gravando o máximo de streams permitido. Pare outra gravação e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер записи уже записывает максимально допустимое число потоков. Остановите другую запись и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt sunucusu zaten izin verdiği sayıda yayını kaydediyor. Başka bir kaydı durdurup yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制服务器已达到允许同时录制的流数量上限。请停止其他录制后重试。"
          }
        }
      }
    },
    "The recording server is out of disk space. Delete some recordings and try again." : {
      "comment" : "Recording server error: not enough free disk space.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفدت مساحة القرص في خادم التسجيل. احذف بعض التسجيلات وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Aufnahmeserver ist kein Speicherplatz mehr frei. Lösche einige Aufnahmen und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recording server is out of disk space. Delete some recordings and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de grabación se ha quedado sin espacio en disco. Elimina algunas grabaciones e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur d’enregistrement n’a plus d’espace disque. Supprimez des enregistrements et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
