    "Adds the technical readout: quality, codec, frame rate, and playback engine." : {
      "comment" : "Description of the Advanced stream-information detail level.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف المعلومات التقنية: الجودة والترميز ومعدل الإطارات ومحرك التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergänzt die technischen Angaben: Qualität, Codec, Bildrate und Wiedergabe-Engine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los datos técnicos: calidad, códec, frecuencia de imagen y motor de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute les informations techniques : qualité, codec, fréquence d’images et moteur de lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge i dati tecnici: qualità, codec, frequenza fotogrammi e motore di riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画質、コーデック、フレームレート、再生エンジンなどの技術情報を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화질, 코덱, 프레임 속도, 재생 엔진 등 기술 정보를 추가합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt de technische gegevens toe: kwaliteit, codec, framesnelheid en afspeelengine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje dane techniczne: jakość, kodek, liczbę klatek i silnik odtwarzania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona os dados técnicos: qualidade, codec, taxa de quadros e mecanismo de reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет технические данные: качество, кодек, частоту кадров и движок воспроизведения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknik bilgileri ekler: kalite, kodek, kare hızı ve oynatma motoru."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外显示技术信息：画质、编解码器、帧率和播放引擎。"
          }
        }
      }
    },
