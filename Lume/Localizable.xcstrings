          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 URL은 WebDAV 공유로 응답하지 않습니다. 서버 주소만이 아니라 공유 폴더의 전체 경로를 입력하세요."
          }
        },
        "pt" : {
          "stringUnit" : {
