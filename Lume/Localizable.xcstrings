    "This will be visible on your TV. Make sure no one else can see the screen." : {
      "comment" : "Message of the tvOS alert asking before the Lume Cloud recovery key appears on the TV screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر هذا على تلفزيونك. تأكد من أن لا أحد غيرك يرى الشاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird auf deinem Fernseher angezeigt. Achte darauf, dass niemand sonst den Bildschirm sehen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will be visible on your TV. Make sure no one else can see the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se verá en tu televisor. Asegúrate de que nadie más pueda ver la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sera visible sur votre téléviseur. Assurez-vous que personne d’autre ne peut voir l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarà visibile sul televisore. Assicurati che nessun altro possa vedere lo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テレビに表示されます。ほかの人に画面が見えないことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV에 표시됩니다. 다른 사람이 화면을 볼 수 없는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij wordt op je tv getoond. Zorg dat niemand anders het scherm kan zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz będzie widoczny na telewizorze. Upewnij się, że nikt inny nie widzi ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela ficará visível na sua TV. Certifique-se de que ninguém mais possa ver a tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ будет показан на экране телевизора. Убедитесь, что его никто больше не видит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, TV'nizde görünecek. Ekranı başka kimsenin göremediğinden emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将显示在电视上。请确保没有其他人能看到屏幕。"
          }
        }
      }
    },
