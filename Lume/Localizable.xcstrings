    "Turns your iPhone to landscape when a video starts, and back to portrait when the player closes." : {
      "comment" : "Footer under the Playback settings section, describing the iPhone-only Rotate to Landscape toggle.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدير iPhone إلى الوضع الأفقي عند بدء الفيديو، ويعيده إلى الوضع العمودي عند إغلاق المشغّل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreht dein iPhone ins Querformat, sobald ein Video startet, und zurück ins Hochformat, wenn der Player geschlossen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira el iPhone a horizontal al empezar un vídeo y lo devuelve a vertical al cerrar el reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe l’iPhone en mode paysage au lancement d’une vidéo, puis en mode portrait à la fermeture du lecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota l’iPhone in orizzontale all’avvio di un video e di nuovo in verticale alla chiusura del player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画の再生が始まるとiPhoneを横向きにし、プレーヤーを閉じると縦向きに戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상이 시작되면 iPhone을 가로 모드로, 플레이어를 닫으면 세로 모드로 되돌립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draait je iPhone naar liggend als een video start, en terug naar staand als de speler sluit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraca iPhone’a do orientacji poziomej po uruchomieniu wideo i z powrotem do pionowej po zamknięciu odtwarzacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira o iPhone para paisagem quando um vídeo começa e volta para retrato quando o player é fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поворачивает iPhone в альбомную ориентацию при запуске видео и обратно в книжную, когда плеер закрывается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir video başladığında iPhone'unuzu yatay konuma, oynatıcı kapandığında yeniden dikey konuma döndürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频开始播放时将 iPhone 旋转至横屏，关闭播放器后恢复竖屏。"
          }
        }
      }
    },
