        }
      }
    },
    "The address of the computer running LumeRecorder. Without a port, Lume uses %@." : {
      "comment" : "Recording server pairing sheet: address footer; the placeholder is the default port number. LumeRecorder is a product name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان الكمبيوتر الذي يشغّل LumeRecorder. بدون منفذ، يستخدم Lume المنفذ %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse des Computers, auf dem LumeRecorder läuft. Ohne Port verwendet Lume %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address of the computer running LumeRecorder. Without a port, Lume uses %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del ordenador que ejecuta LumeRecorder. Si no indicas un puerto, Lume usa el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse de l’ordinateur qui exécute LumeRecorder. Sans port, Lume utilise %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indirizzo del computer su cui è in esecuzione LumeRecorder. Senza porta, Lume usa la %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LumeRecorder を実行しているコンピュータのアドレスです。ポートを省略すると、Lume はポート %@ を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LumeRecorder를 실행 중인 컴퓨터의 주소입니다. 포트를 생략하면 Lume는 %@ 포트를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
