    "premium.chromecast.subtitle" : {
      "comment" : "Lume Pro feature description: casting from iPhone or iPad to a Chromecast on the same network.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل البث المباشر والأفلام والحلقات من iPhone أو iPad إلى جهاز Chromecast وتحكم فيها من Lume."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende Live-TV, Filme und Folgen von deinem iPhone oder iPad an einen Chromecast und steuere sie in Lume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send live TV, movies and episodes from your iPhone or iPad to a Chromecast and control them from Lume."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía TV en directo, películas y episodios desde tu iPhone o iPad a un Chromecast y contrólalos desde Lume."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez la TV en direct, des films et des épisodes de votre iPhone ou iPad vers un Chromecast et contrôlez-les depuis Lume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia TV in diretta, film ed episodi dal tuo iPhone o iPad a un Chromecast e controllali da Lume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone や iPad からライブ TV、映画、エピソードを Chromecast に送信し、Lume で操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 또는 iPad에서 실시간 TV, 영화, 에피소드를 Chromecast로 보내고 Lume에서 제어하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur live-tv, films en afleveringen van je iPhone of iPad naar een Chromecast en bedien ze vanuit Lume."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłaj telewizję na żywo, filmy i odcinki z iPhone’a lub iPada na Chromecast i steruj nimi w Lume."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie TV ao vivo, filmes e episódios do seu iPhone ou iPad para um Chromecast e controle tudo pelo Lume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте прямой эфир, фильмы и эпизоды с iPhone или iPad на Chromecast и управляйте ими из Lume."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı TV'yi, filmleri ve bölümleri iPhone'unuzdan veya iPad'inizden bir Chromecast'e gönderin ve Lume'dan denetleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将直播电视、电影和剧集从 iPhone 或 iPad 发送到 Chromecast，并在 Lume 中控制播放。"
          }
        }
      }
    },
