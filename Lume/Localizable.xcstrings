          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa URL no responde como un recurso compartido WebDAV. Introduce la ruta completa de la carpeta compartida, no solo la dirección del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette URL ne répond pas comme un partage WebDAV. Saisissez le chemin complet du dossier partagé, pas seulement l’adresse du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
