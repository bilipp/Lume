    "End-to-end encrypted. Only your devices can read what you sync." : {
      "comment" : "Subtitle of the first-run Lume Cloud step (create, join or restore an account).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشفّر من طرف إلى طرف. لا يمكن لأحد سوى أجهزتك قراءة ما تزامنه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ende-zu-Ende-verschlüsselt. Nur deine Geräte können lesen, was du synchronisierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end encrypted. Only your devices can read what you sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrado de extremo a extremo. Solo tus dispositivos pueden leer lo que sincronizas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffré de bout en bout. Seuls vos appareils peuvent lire ce que vous synchronisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crittografia end-to-end. Solo i tuoi dispositivi possono leggere ciò che sincronizzi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドツーエンドで暗号化。同期した内容を読めるのはあなたのデバイスだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종단 간 암호화. 동기화한 내용은 내 기기에서만 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End-to-end versleuteld. Alleen je eigen apparaten kunnen lezen wat je synchroniseert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełne szyfrowanie. Tylko Twoje urządzenia mogą odczytać synchronizowane dane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografia de ponta a ponta. Só seus dispositivos podem ler o que você sincroniza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сквозное шифрование. Синхронизируемые данные можете прочитать только вы на своих устройствах."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uçtan uca şifreli. Eşzamanladıklarınızı yalnızca aygıtlarınız okuyabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端到端加密。只有你的设备能读取你同步的内容。"
          }
        }
      }
    },
    "End-to-end encrypted. Syncs across Apple and Android devices." : {
