    "Touch and hold Play to pick a source at any time." : {
      "comment" : "iOS player settings hint: a long press on a movie or series Play button opens the source picker.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس \"تشغيل\" مطولًا لاختيار مصدر في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte „Abspielen“ gedrückt, um jederzeit eine Quelle zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold Play to pick a source at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado Reproducir para elegir una fuente en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Lecture de manière prolongée pour choisir une source à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto Riproduci per scegliere una fonte in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再生」を長押しすると、いつでもソースを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생을 길게 터치하면 언제든지 소스를 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd “Speel af” ingedrukt om op elk moment een bron te kiezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj przycisk Odtwórz, aby w każdej chwili wybrać źródło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado Reproduzir para escolher uma fonte a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы в любой момент выбрать источник, коснитесь кнопки «Воспроизвести» и удерживайте ее."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğiniz zaman bir kaynak seçmek için Oynat'a dokunup basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住“播放”可随时选择来源。"
          }
        }
      }
    },
