    "iCloud is temporarily unavailable. Sync resumes automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud غير متوفر مؤقتًا. ستُستأنف المزامنة تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist vorübergehend nicht verfügbar. Die Synchronisierung wird automatisch fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible temporalmente. La sincronización se reanuda automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est temporairement indisponible. La synchronisation reprend automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud è temporaneamente non disponibile. La sincronizzazione riprende automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudは一時的に利用できません。同期は自動的に再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud를 일시적으로 사용할 수 없습니다. 동기화가 자동으로 다시 시작됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is tijdelijk niet beschikbaar. Synchronisatie wordt automatisch hervat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud jest chwilowo niedostępny. Synchronizacja zostanie wznowiona automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud está temporariamente indisponível. A sincronização é retomada automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud временно недоступен. Синхронизация возобновится автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
