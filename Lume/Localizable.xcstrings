    "KSPlayer is a powerful third-party player that supports a wide range of formats, including those commonly used in IPTV streams." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer مشغّل قوي من جهة خارجية يدعم مجموعة واسعة من التنسيقات، بما فيها التنسيقات الشائعة في بثوث IPTV."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer ist ein leistungsstarker Drittanbieter-Player, der eine Vielzahl von Formaten unterstützt – einschließlich der bei IPTV-Streams gängigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer es un potente reproductor de terceros que admite una amplia gama de formatos, incluidos los que se usan habitualmente en los streams de IPTV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer est un puissant lecteur tiers qui prend en charge une large gamme de formats, y compris ceux couramment utilisés dans les flux IPTV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer è un potente lettore di terze parti che supporta un'ampia gamma di formati, inclusi quelli comunemente usati negli stream IPTV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayerは強力なサードパーティ製プレーヤーで、IPTVストリームでよく使われる形式を含む幅広い形式をサポートしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer는 IPTV 스트림에서 흔히 사용되는 포맷을 포함하여 다양한 포맷을 지원하는 강력한 서드파티 플레이어입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer is een krachtige speler van derden die een groot aantal formaten ondersteunt, waaronder de formaten die vaak in iptv-streams worden gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer to rozbudowany odtwarzacz innej firmy, który obsługuje wiele formatów – w tym te powszechnie używane w strumieniach IPTV."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O KSPlayer é um poderoso player de terceiros que suporta uma ampla variedade de formatos, incluindo os comumente usados em streams de IPTV."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer — мощный сторонний плеер, поддерживающий множество форматов, включая распространенные в IPTV-потоках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer, IPTV yayınlarında yaygın olarak kullanılanlar dahil çok çeşitli biçimleri destekleyen güçlü bir üçüncü taraf oynatıcıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KSPlayer是一款功能强大的第三方播放器，支持多种格式，包括IPTV流中常用的格式。"
          }
        }
      }
    },
