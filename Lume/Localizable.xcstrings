          "stringUnit" : {
            "state" : "translated",
            "value" : "리그와 팀을 추가하면 경기 일정, 실시간 스코어, 순위를 확인하고 경기를 중계하는 채널로 한 번에 이동할 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione ligas e times para ver jogos, placares ao vivo e classificações, com um toque para o canal que transmite o jogo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加联赛和球队即可查看赛程、实时比分和积分榜，轻点一下即可跳转到转播该场比赛的频道。"
          }
        }
      }
    },
