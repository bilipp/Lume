    "settings.hue.discovery.localNetwork" : {
      "comment" : "Philips Hue settings: Local Network access was declined, so bridges can't be found (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Lume إلى الوصول إلى الشبكة المحلية للعثور على الجسر. اسمح بذلك في الإعدادات › التطبيقات › Lume، أو أدخل عنوان IP للجسر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume benötigt Zugriff auf das lokale Netzwerk, um die Bridge zu finden. Erlaube ihn unter Einstellungen › Apps › Lume oder gib die IP-Adresse der Bridge ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume needs Local Network access to find the bridge. Allow it in Settings › Apps › Lume, or enter the bridge's IP address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume necesita acceso a la red local para encontrar el puente. Permítelo en Ajustes › Apps › Lume o introduce la dirección IP del puente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume a besoin d’accéder au réseau local pour trouver le pont. Autorisez-le dans Réglages › Apps › Lume, ou saisissez l’adresse IP du pont."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume ha bisogno dell’accesso alla rete locale per trovare il bridge. Consentilo in Impostazioni › App › Lume oppure inserisci l’indirizzo IP del bridge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブリッジを見つけるには、Lume にローカルネットワークへのアクセスが必要です。「設定」›「アプリ」›「Lume」で許可するか、ブリッジの IP アドレスを入力してください。"
