            "value" : "لا توجد عناصر مفضلة بعد. أضف القنوات أو الأفلام أو المسلسلات إلى المفضلة لإدارة ترتيبها هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Favoriten. Markiere Sender, Filme oder Serien als Favoriten, um ihre Reihenfolge hier zu verwalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay favoritos. Marca canales, películas o series como favoritos para gestionar su orden aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun favori pour l’instant. Marquez des chaînes, films ou séries comme favoris pour gérer leur ordre ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun preferito. Contrassegna canali, film o serie come preferiti per gestirne l’ordine qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りはまだありません。チャンネル、映画、シリーズをお気に入りに登録すると、ここで順序を管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 즐겨찾기가 없습니다. 채널, 영화 또는 시리즈를 즐겨찾기로 표시하면 여기에서 순서를 관리할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen favorieten. Markeer zenders, films of series als favoriet om hier hun volgorde te beheren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak ulubionych. Oznacz kanały, filmy lub seriale jako ulubione, aby zarządzać tutaj ich kolejnością."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há favoritos. Marque canais, filmes ou séries como favoritos para gerenciar a ordem deles aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избранного пока нет. Добавьте каналы, фильмы или сериалы в избранное, чтобы управлять их порядком здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz favori yok. Sıralamalarını burada yönetmek için kanalları, filmleri veya dizileri favori olarak işaretleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无收藏。将频道、电影或剧集标记为收藏，即可在此管理它们的顺序。"
          }
        }
      }
    },
