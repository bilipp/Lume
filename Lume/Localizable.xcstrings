    "settings.hue.test.areaInUse" : {
      "comment" : "Philips Hue settings: the light test found the entertainment area in use by another app (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق آخر منطقة الترفيه هذه. أوقفه هناك، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App verwendet diesen Entertainment-Bereich. Beende sie dort und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app is using this entertainment area. Stop it there, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando esta área de entretenimiento. Detenla allí y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app utilise cette zone de divertissement. Arrêtez-la, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'altra app sta usando quest'area di intrattenimento. Interrompila e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリがこのエンターテインメントエリアを使用しています。そちらで停止してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 이 엔터테인먼트 영역을 사용 중입니다. 해당 앱에서 중지한 뒤 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een andere app gebruikt deze entertainmentruimte. Stop die daar en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inna aplikacja używa tej strefy rozrywki. Zatrzymaj ją tam i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app está usando esta área de entretenimento. Pare-o lá e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта зона развлечений используется другим приложением. Остановите его и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eğlence alanını başka bir uygulama kullanıyor. Orada durdurun, ardından yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个应用正在使用此娱乐区域。请在该应用中停止，然后重试。"
          }
        }
      }
    },
    "settings.hue.test.footer" : {
      "comment" : "Philips Hue settings: footnote under the Test Lights row (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحول أضواء المنطقة إلى الأحمر والأخضر والأزرق والأبيض، ثم تعود إلى ما كانت عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lampen des Bereichs leuchten rot, grün, blau und weiß und kehren dann in ihren vorherigen Zustand zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The area's lights turn red, green, blue and white, then go back to how they were."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las luces del área se vuelven rojas, verdes, azules y blancas, y luego vuelven a como estaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lampes de la zone passent au rouge, au vert, au bleu et au blanc, puis reviennent à leur état précédent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le luci dell'area diventano rosse, verdi, blu e bianche, poi tornano com'erano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エリアのライトが赤、緑、青、白に変わり、その後元の状態に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역의 조명이 빨간색, 초록색, 파란색, 흰색으로 바뀐 뒤 원래 상태로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lampen in de ruimte worden rood, groen, blauw en wit, en keren daarna terug naar hoe ze waren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Światła strefy zaświecą na czerwono, zielono, niebiesko i biało, a potem wrócą do poprzedniego stanu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As luzes da área ficam vermelhas, verdes, azuis e brancas e depois voltam a como estavam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лампы зоны загорятся красным, зеленым, синим и белым, а затем вернутся в прежнее состояние."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alanın ışıkları kırmızı, yeşil, mavi ve beyaz yanar, ardından önceki durumlarına döner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该区域的灯光会依次变为红色、绿色、蓝色和白色，然后恢复原状。"
          }
        }
      }
    },
    "settings.hue.test.streamFailed" : {
      "comment" : "Philips Hue settings: the light test couldn't stream to the bridge (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يقبل الجسر بث الأضواء. تأكد من أن Apple TV والجسر على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bridge hat den Lichtstream nicht angenommen. Prüfe, ob Apple TV und Bridge im selben Netzwerk sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bridge didn't accept the light stream. Check that the Apple TV and the bridge are on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente no aceptó la transmisión de luz. Comprueba que el Apple TV y el puente estén en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont n'a pas accepté le flux lumineux. Vérifiez que l'Apple TV et le pont sont sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bridge non ha accettato lo streaming delle luci. Verifica che Apple TV e il bridge siano sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブリッジがライトのストリームを受け付けませんでした。Apple TVとブリッジが同じネットワークにあるか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브리지가 조명 스트림을 받지 않았습니다. Apple TV와 브리지가 같은 네트워크에 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bridge heeft de lichtstream niet geaccepteerd. Controleer of de Apple TV en de bridge op hetzelfde netwerk zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostek nie przyjął strumienia świateł. Sprawdź, czy Apple TV i mostek są w tej samej sieci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bridge não aceitou a transmissão de luz. Verifique se a Apple TV e a Bridge estão na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мост не принял поток света. Убедитесь, что Apple TV и мост подключены к одной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü ışık akışını kabul etmedi. Apple TV'nin ve köprünün aynı ağda olduğundan emin olun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接器未接受灯光流。请确认 Apple TV 和桥接器位于同一网络。"
          }
        }
      }
    },
    "settings.hue.test.unsupportedArea" : {
