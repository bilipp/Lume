    "The server rejected this username and password. Leave both empty if the share allows anonymous access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض الخادم اسم المستخدم وكلمة السر هذين. اترك الحقلين فارغين إذا كان المجلد المشترك يسمح بالوصول المجهول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diesen Benutzernamen und dieses Passwort abgelehnt. Lass beide leer, wenn die Freigabe anonymen Zugriff erlaubt."
