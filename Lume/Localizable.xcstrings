          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu armazenamento do iCloud está cheio. Liberte espaço ou faça upgrade do plano para retomar a sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище iCloud заполнено. Освободите место или расширьте тариф, чтобы возобновить синхронизацию."
