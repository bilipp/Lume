        }
      }
    },
    "The EPG URL is read from the playlist when left empty." : {
      "comment" : "A description of the EPG URL field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقرأ URL الخاص بـ EPG من قائمة التشغيل عند تركه فارغًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die EPG-URL wird aus der Wiedergabeliste gelesen, wenn das Feld leer bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL de la guía de TV se lee de la lista de reproducción cuando se deja vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL du Guide TV est lue depuis la playlist lorsque ce champ est laissé vide."
          }
        },
        "it" : {
