    "A positive audio delay plays sound later. " : {
      "comment" : "AetherEngine options in Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تأخير الصوت الموجب إلى تشغيل الصوت لاحقًا. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine positive Audioverzögerung gibt den Ton später wieder. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A positive audio delay plays sound later. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un retraso de audio positivo reproduce el sonido más tarde. "
          }
        },
