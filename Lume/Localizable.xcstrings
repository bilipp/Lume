    "Add leagues and teams to see fixtures, live scores and standings, with one tap to the channel carrying the game." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الدوريات والفرق لمتابعة المباريات والنتائج المباشرة والترتيب، مع الانتقال بنقرة واحدة إلى القناة التي تنقل المباراة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Ligen und Teams hinzu, um Spielpläne, Live-Ergebnisse und Tabellen zu sehen – mit einem Tippen zum Sender, der das Spiel überträgt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade ligas y equipos para ver partidos, resultados en directo y clasificaciones, con un toque al canal que emite el partido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des ligues et des équipes pour voir les matchs, les scores en direct et les classements, avec un appui vers la chaîne qui diffuse le match."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi campionati e squadre per vedere partite, risultati in diretta e classifiche, con un tocco sul canale che trasmette la partita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーグやチームを追加すると、試合日程・ライブスコア・順位表が表示され、試合を放送するチャンネルにワンタップで移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리그와 팀을 추가하면 경기 일정, 실시간 스코어, 순위를 확인하고 경기를 중계하는 채널로 한 번에 이동할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg competities en teams toe voor wedstrijdschema’s, live-uitslagen en standen, met één tik naar de zender die de wedstrijd uitzendt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ligi i drużyny, aby widzieć terminarze, wyniki na żywo i tabele – z przejściem jednym stuknięciem do kanału transmitującego mecz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione ligas e times para ver jogos, placares ao vivo e classificações, com um toque para o canal que transmite o jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте лиги и команды, чтобы видеть расписание матчей, счет в реальном времени и турнирные таблицы, а также одним касанием переходить на канал с трансляцией."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikstürleri, canlı skorları ve puan durumlarını görmek için lig ve takım ekleyin; maçı yayınlayan kanala tek dokunuşla geçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加联赛和球队即可查看赛程、实时比分和积分榜，轻点一下即可跳转到转播该场比赛的频道。"
          }
        }
      }
    },
