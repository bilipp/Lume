    "You've used up today's OpenSubtitles downloads. Try again tomorrow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد استنفدت تنزيلات OpenSubtitles لهذا اليوم. حاول مرة أخرى غدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die heutigen OpenSubtitles-Downloads aufgebraucht. Versuche es morgen erneut."
