          }
        }
      }
    },
    "A sentence or two helps a lot. It's added to the top of the report." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جملة أو اثنتان تساعدان كثيرًا. تُضاف إلى أعلى التقرير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein, zwei Sätze helfen sehr. Sie werden oben im Bericht eingefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una o dos frases ayudan mucho. Se añaden al principio del informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ou deux phrases aident beaucoup. Elles sont ajoutées en haut du rapport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una o due frasi aiutano molto. Vengono aggiunte all'inizio del rapporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一言、二言でも大いに役立ちます。レポートの先頭に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한두 문장만 적어 주셔도 큰 도움이 됩니다. 보고서 맨 위에 추가됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een paar zinnen helpen al veel. Ze worden bovenaan het rapport toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno lub dwa zdania bardzo pomogą. Zostaną dodane na początku raportu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ou duas frases ajudam muito. Elas são adicionadas ao início do relatório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пара предложений очень поможет. Они будут добавлены в начало отчета."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir iki cümle çok yardımcı olur. Raporun en üstüne eklenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一两句话就很有帮助。它会添加到报告的开头。"
          }
        }
      }
    },
