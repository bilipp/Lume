    "Wrong username or password. OpenSubtitles wants your username here, not your email address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم المستخدم أو كلمة السر غير صحيحة. يطلب OpenSubtitles اسم المستخدم هنا، وليس عنوان بريدك الإلكتروني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falscher Benutzername oder falsches Passwort. OpenSubtitles erwartet hier deinen Benutzernamen, nicht deine E-Mail-Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de usuario o contraseña incorrectos. OpenSubtitles espera aquí tu nombre de usuario, no tu correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom d’utilisateur ou mot de passe incorrect. OpenSubtitles attend ici votre nom d’utilisateur, pas votre adresse e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome utente o password errati. Qui OpenSubtitles si aspetta il tuo nome utente, non il tuo indirizzo email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名またはパスワードが正しくありません。OpenSubtitlesはここでメールアドレスではなくユーザー名を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름 또는 비밀번호가 올바르지 않습니다. OpenSubtitles는 여기에 이메일이 아닌 사용자 이름을 요구합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onjuiste gebruikersnaam of onjuist wachtwoord. OpenSubtitles verwacht hier je gebruikersnaam, niet je e-mailadres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błędna nazwa użytkownika lub hasło. OpenSubtitles wymaga tu nazwy użytkownika, a nie adresu e‑mail."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nome de usuário ou senha incorretos. O OpenSubtitles espera seu nome de usuário aqui, não seu e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверное имя пользователя или пароль. Для OpenSubtitles здесь нужно указать имя пользователя, а не адрес электронной почты."
          }
        },
        "tr" : {
          "stringUnit" : {
