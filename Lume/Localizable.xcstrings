    "Automatically start the next episode when one finishes." : {
      "comment" : "Footer under the Playback settings section. iOS/macOS/visionOS only - the outro-armed Next Episode button this used to also describe exists on tvOS alone now.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet die nächste Folge automatisch, sobald eine endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia automáticamente el siguiente episodio cuando termina uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance automatiquement l’épisode suivant à la fin du précédent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia automaticamente l'episodio successivo al termine di quello in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードが終わると自動的に次のエピソードを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에피소드가 끝나면 자동으로 다음 에피소드를 재생합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar automaticamente o próximo episódio quando um terminar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一集播放结束时自动开始下一集。"
          }
        }
      }
    },
    "Autoplay Next Episode" : {
