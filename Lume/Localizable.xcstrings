        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas vão aparecer assim.\nEscolha um estilo fácil de ler."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так будут выглядеть субтитры.\nВыберите удобный для чтения стиль."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
