    },
    "This device stops syncing. Your Lume Cloud account and its data stay, so you can rejoin later." : {
      "comment" : "Leave Lume Cloud confirmation in builds without iCloud: the device stops syncing.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف هذا الجهاز عن المزامنة. يبقى حساب Lume Cloud وبياناته، لذا يمكنك الانضمام مجددًا لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät synchronisiert nicht mehr. Dein Lume Cloud-Account und seine Daten bleiben erhalten, sodass du später wieder beitreten kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device stops syncing. Your Lume Cloud account and its data stay, so you can rejoin later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo dejará de sincronizarse. Tu cuenta de Lume Cloud y sus datos se conservan, así que puedes volver a unirte más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil cesse de se synchroniser. Votre compte Lume Cloud et ses données sont conservés : vous pourrez le rejoindre plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo smetterà di sincronizzarsi. Il tuo account Lume Cloud e i relativi dati restano, quindi potrai unirti di nuovo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは同期を停止します。Lume Cloudアカウントとそのデータは残るため、あとで再参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 동기화가 중지됩니다. Lume Cloud 계정과 데이터는 유지되므로 나중에 다시 참여할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat stopt met synchroniseren. Je Lume Cloud-account en de gegevens ervan blijven bewaard, zodat je later weer kunt meedoen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie przestanie się synchronizować. Konto Lume Cloud i jego dane pozostaną, więc możesz później ponownie dołączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo deixa de sincronizar. Sua conta do Lume Cloud e os dados dela continuam, então você pode entrar novamente depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство перестанет синхронизироваться. Учетная запись Lume Cloud и ее данные сохранятся, так что позже можно будет подключиться снова."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıt eşzamanlamayı durdurur. Lume Cloud hesabınız ve verileri korunur; böylece daha sonra yeniden katılabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将停止同步。你的 Lume Cloud 账户及其数据会保留，以后可以重新加入。"
          }
        }
      }
    },
    "This device was removed from Lume Cloud. Sync is off; your data stays on this device." : {
      "comment" : "Alert after another device removed this one from Lume Cloud; sync is now off on this device. Lume Cloud is a product name; keep it in Latin script.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إزالة هذا الجهاز من Lume Cloud. المزامنة متوقفة؛ تبقى بياناتك على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät wurde aus Lume Cloud entfernt. Die Synchronisierung ist aus; deine Daten bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device was removed from Lume Cloud. Sync is off; your data stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo se ha eliminado de Lume Cloud. La sincronización está desactivada; tus datos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a été retiré de Lume Cloud. La synchronisation est désactivée ; vos données restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo è stato rimosso da Lume Cloud. La sincronizzazione è disattivata; i tuoi dati restano su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはLume Cloudから削除されました。同期はオフです。データはこのデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 Lume Cloud에서 제거되었습니다. 동기화가 꺼져 있으며, 데이터는 이 기기에 남아 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat is uit Lume Cloud verwijderd. Synchronisatie staat uit; je gegevens blijven op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie zostało usunięte z Lume Cloud. Synchronizacja jest wyłączona; dane pozostają na tym urządzeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo foi removido do Lume Cloud. A sincronização está desativada; seus dados ficam neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство удалено из Lume Cloud. Синхронизация выключена, данные остаются на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıt Lume Cloud'dan kaldırıldı. Eşzamanlama kapalı; verileriniz bu aygıtta kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备已从 Lume Cloud 中移除。同步已关闭；你的数据会保留在此设备上。"
          }
        }
      }
    },
