          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画サーバーのディスク容量が不足しています。録画をいくつか削除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 서버의 디스크 공간이 부족합니다. 일부 녹화를 삭제한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opnameserver heeft geen schijfruimte meer. Verwijder enkele opnamen en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na serwerze nagrywania brakuje miejsca na dysku. Usuń kilka nagrań i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor de gravação está sem espaço em disco. Apague algumas gravações e tente novamente."
          }
        },
        "ru" : {
