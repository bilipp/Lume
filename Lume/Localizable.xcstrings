    "The TMDB metadata and on-device embeddings for every title will be wiped, then re-indexed from scratch in the background." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم مسح بيانات TMDB الوصفية والتضمينات المحفوظة على الجهاز لكل العناوين، ثم إعادة فهرستها من البداية في الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die TMDB-Metadaten und die lokalen Embeddings aller Titel werden gelöscht und anschließend im Hintergrund neu indiziert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán los metadatos de TMDB y las incrustaciones locales de todos los títulos, y se volverán a indexar desde cero en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les métadonnées TMDB et les embeddings locaux de tous les titres seront effacés, puis réindexés de zéro en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I metadati TMDB e gli embedding locali di tutti i titoli verranno eliminati e poi re-indicizzati da zero in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのタイトルの TMDB メタデータとデバイス上の埋め込みが消去され、バックグラウンドで最初から再インデックスされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 항목의 TMDB 메타데이터와 기기 내 임베딩이 삭제된 뒤, 백그라운드에서 처음부터 다시 색인됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De TMDB-metadata en de embeddings op het apparaat worden voor elke titel gewist en daarna op de achtergrond opnieuw geïndexeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metadane TMDB i lokalne osadzenia wszystkich tytułów zostaną usunięte, a następnie zindeksowane od nowa w tle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os metadados do TMDB e os embeddings locais de todos os títulos serão apagados e depois reindexados a partir do zero em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Метаданные TMDB и локальные эмбеддинги всех материалов будут удалены, а затем заново проиндексированы в фоне."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm içeriklerin TMDB meta verileri ve aygıt üzerindeki gömmeleri silinecek, ardından arka planda sıfırdan yeniden dizinlenecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除所有影片的 TMDB 元数据和设备端嵌入向量，随后在后台重新建立索引。"
          }
        }
      }
    },
