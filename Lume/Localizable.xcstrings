    "Lume Cloud can’t be reached right now. Try again in a moment." : {
      "comment" : "Error after a one-off Lume Cloud action (create, delete, rename) when the server is unreachable or failing.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر الوصول إلى Lume Cloud الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud ist gerade nicht erreichbar. Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud can’t be reached right now. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede acceder a Lume Cloud en este momento. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud est injoignable pour le moment. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento Lume Cloud non è raggiungibile. Riprova tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在Lume Cloudに接続できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 Lume Cloud에 연결할 수 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud is nu niet bereikbaar. Probeer het zo meteen opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud jest teraz niedostępne. Spróbuj ponownie za chwilę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível acessar o Lume Cloud agora. Tente novamente em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud сейчас недоступен. Повторите попытку чуть позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud'a şu anda ulaşılamıyor. Biraz sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法连接 Lume Cloud。请稍后再试。"
          }
        }
      }
    },
    "Lume Cloud can’t be reached. Sync resumes automatically." : {
