          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los datos técnicos: calidad, códec, frecuencia de imagen y motor de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
