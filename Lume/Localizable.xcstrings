    "Sync the movies and episodes you watch to Simkl." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere die Filme und Episoden, die du ansiehst, mit Simkl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza con Simkl las películas y los episodios que ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisez les films et les épisodes que vous regardez avec Simkl."
          }
