          }
        }
      }
    },
    "This URL does not point to a Jellyfin or Emby server. Enter the server's base address, e.g. http://192.168.1.10:8096." : {
      "comment" : "Error message when the URL is not a Jellyfin or Emby server.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese URL verweist nicht auf einen Jellyfin- oder Emby-Server. Gib die Basisadresse des Servers ein, z. B. http://192.168.1.10:8096."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta URL no apunta a un servidor Jellyfin o Emby. Introduce la dirección base del servidor, p. ej. http://192.168.1.10:8096."
          }
        },
        "fr" : {
          "stringUnit" : {
