    "Enter a valid server address, such as 192.168.1.20:%@." : {
      "comment" : "Recording server setup: the typed address is not a valid host. The placeholder is the default port number.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل عنوان خادم صالحًا، مثل 192.168.1.20:%@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib eine gültige Serveradresse ein, z. B. 192.168.1.20:%@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a valid server address, such as 192.168.1.20:%@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una dirección de servidor válida, como 192.168.1.20:%@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une adresse de serveur valide, par exemple 192.168.1.20:%@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un indirizzo del server valido, ad esempio 192.168.1.20:%@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なサーバーアドレスを入力してください（例：192.168.1.20:%@）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "올바른 서버 주소를 입력하세요(예: 192.168.1.20:%@)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een geldig serveradres in, zoals 192.168.1.20:%@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź prawidłowy adres serwera, np. 192.168.1.20:%@."
          }
        },
        "pt" : {
          "stringUnit" : {
