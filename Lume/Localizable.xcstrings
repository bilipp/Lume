    "Channels from this playlist can only be recorded while they're on air." : {
      "comment" : "Schedule Recording refused: this playlist type (Stalker portal) can only record now.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تسجيل قنوات قائمة التشغيل هذه إلا أثناء بثها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sender aus dieser Playlist können nur während der Ausstrahlung aufgenommen werden."
          }
