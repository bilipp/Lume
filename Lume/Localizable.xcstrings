    "FFmpeg honours every option below for all streams. " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلتزم FFmpeg بجميع الخيارات أدناه لكل أنواع البث. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg berücksichtigt alle Optionen unten für sämtliche Streams. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg respeta todas las opciones de abajo para todos los streams. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg respecte chacune des options ci-dessous pour tous les flux. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg rispetta tutte le opzioni seguenti per tutti gli stream. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpegはすべてのストリームに対して以下のすべてのオプションを適用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg는 모든 스트림에 대해 아래의 모든 옵션을 적용합니다. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg past alle onderstaande opties toe op alle streams. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg uwzględnia wszystkie poniższe opcje dla wszystkich strumieni. "
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O FFmpeg respeita todas as opções abaixo para todos os streams. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg учитывает все параметры ниже для всех потоков. "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg, aşağıdaki tüm seçenekleri tüm yayınlar için uygular. "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg对所有流都遵循以下每个选项。"
          }
        }
      }
    },
    "FFmpeg-based engine with hardware decoding, HDR, multichannel audio, deinterlacing and Picture in Picture. Plays HLS through Apple's native player where it can." : {
      "comment" : "Description of AetherEngine, an optional playback engine, shown in the engine priority list.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرك قائم على FFmpeg يدعم فك الترميز عبر العتاد وHDR والصوت متعدد القنوات وإزالة التشابك وصورة داخل صورة. يشغّل HLS عبر مشغّل Apple الأصلي حيثما أمكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg-basierte Engine mit Hardware-Dekodierung, HDR, Mehrkanal-Audio, Deinterlacing und Bild-in-Bild. Spielt HLS nach Möglichkeit über Apples nativen Player ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FFmpeg-based engine with hardware decoding, HDR, multichannel audio, deinterlacing and Picture in Picture. Plays HLS through Apple's native player where it can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor basado en FFmpeg con decodificación por hardware, HDR, audio multicanal, desentrelazado e imagen dentro de imagen. Reproduce HLS con el reproductor nativo de Apple cuando es posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moteur basé sur FFmpeg avec décodage matériel, HDR, audio multicanal, désentrelacement et image dans l’image. Lit le HLS via le lecteur natif d’Apple lorsque c’est possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motore basato su FFmpeg con decodifica hardware, HDR, audio multicanale, deinterlacciamento e Picture in Picture. Riproduce HLS tramite il player nativo di Apple quando possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアデコード、HDR、マルチチャンネルオーディオ、インターレース解除、ピクチャ・イン・ピクチャに対応したFFmpegベースのエンジン。可能な場合はHLSをAppleのネイティブプレーヤーで再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 디코딩, HDR, 멀티채널 오디오, 디인터레이스, 화면 속 화면을 지원하는 FFmpeg 기반 엔진입니다. 가능한 경우 HLS를 Apple 기본 플레이어로 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op FFmpeg gebaseerde engine met hardwaredecodering, HDR, meerkanaalsaudio, deinterlacen en beeld-in-beeld. Speelt HLS waar mogelijk af via de eigen speler van Apple."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silnik oparty na FFmpeg z dekodowaniem sprzętowym, HDR, dźwiękiem wielokanałowym, usuwaniem przeplotu i obrazem w obrazie. Gdy to możliwe, odtwarza HLS natywnym odtwarzaczem Apple."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motor baseado em FFmpeg com decodificação por hardware, HDR, áudio multicanal, desentrelaçamento e Picture in Picture. Reproduz HLS pelo player nativo da Apple quando possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движок на базе FFmpeg с аппаратным декодированием, HDR, многоканальным звуком, деинтерлейсингом и режимом «Картинка в картинке». По возможности воспроизводит HLS через встроенный плеер Apple."
          }
        },
        "tr" : {
