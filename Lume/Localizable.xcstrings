        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseer de films en afleveringen die je kijkt met MDBList, en toon je MDBList-kijklijst in Thuis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuj oglądane filmy i odcinki z MDBList i wyświetlaj listę do obejrzenia MDBList na ekranie głównym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize os filmes e episódios que você assiste com o MDBList e mostre sua lista do MDBList na Tela Inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизируйте просмотренные фильмы и эпизоды с MDBList и выводите свой список MDBList на главный экран."
          }
