    "AVPlayer has no configurable options." : {
      "comment" : "A message displayed when AVPlayer has no configurable options.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتضمن AVPlayer أي خيارات قابلة للتهيئة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer bietet keine konfigurierbaren Optionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer no tiene opciones configurables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer n’a aucune option configurable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer non ha opzioni configurabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayerに設定可能なオプションはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer에는 구성 가능한 옵션이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer heeft geen instelbare opties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer nie ma opcji do skonfigurowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer não tem opções configuráveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У AVPlayer нет настраиваемых параметров."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer'ın yapılandırılabilir seçeneği yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer没有可配置的选项。"
          }
        }
      }
    },
    "AVPlayer is more efficient but ignores most of them — including buffering — for formats it plays natively, such as HLS. Applied the next time playback starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer أكثر كفاءة لكنه يتجاهل معظمها — بما في ذلك التخزين المؤقت — مع التنسيقات التي يشغّلها أصليًا، مثل HLS. يُطبَّق عند بدء التشغيل التالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer ist effizienter, ignoriert aber die meisten davon – einschließlich der Pufferung – bei Formaten, die er nativ abspielt, etwa HLS. Wird bei der nächsten Wiedergabe angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer es más eficiente, pero ignora la mayoría de ellas —incluido el almacenamiento en búfer— para los formatos que reproduce de forma nativa, como HLS. Se aplica la próxima vez que se inicie la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer est plus efficace, mais ignore la plupart d’entre elles — y compris la mise en mémoire tampon — pour les formats qu’il lit nativement, comme HLS. Appliqué au prochain démarrage de la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer è più efficiente ma ne ignora la maggior parte — incluso il buffering — per i formati che riproduce nativamente, come HLS. Applicato al successivo avvio della riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayerはより効率的ですが、HLSなどネイティブに再生できる形式では、バッファを含むほとんどのオプションを無視します。次回の再生開始時に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer는 더 효율적이지만 HLS와 같이 기본적으로 재생하는 포맷의 경우 버퍼링을 포함한 대부분의 옵션을 무시합니다. 다음 재생 시작 시 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer is efficiënter, maar negeert de meeste ervan — ook de buffering — bij formaten die hij zelf afspeelt, zoals HLS. Wordt toegepast bij de volgende keer afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer jest wydajniejszy, ale ignoruje większość z nich – w tym buforowanie – w przypadku formatów odtwarzanych natywnie, takich jak HLS. Zostanie zastosowane przy następnym odtwarzaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AVPlayer é mais eficiente, mas ignora a maioria delas — incluindo o buffer — para formatos que reproduz nativamente, como HLS. Aplicado na próxima vez que a reprodução começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer экономичнее, но игнорирует большинство из них — включая буферизацию — для форматов, которые воспроизводит сам, например HLS. Применится при следующем запуске воспроизведения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer daha verimlidir ancak HLS gibi yerel olarak oynattığı biçimlerde arabelleğe alma dahil bunların çoğunu yok sayar. Bir sonraki oynatmada uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVPlayer效率更高，但对于其原生播放的格式（如HLS），会忽略其中大部分选项，包括缓冲。将在下次播放开始时生效。"
          }
        }
      }
    },
