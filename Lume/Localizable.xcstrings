    "Start fresh. You’ll get a recovery key to keep safe." : {
      "comment" : "Detail under “Create New Account” in the first-run Lume Cloud step.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من جديد. ستحصل على مفتاح استرداد لتحتفظ به في مكان آمن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte neu. Du erhältst einen Wiederherstellungsschlüssel, den du sicher aufbewahren solltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start fresh. You’ll get a recovery key to keep safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza desde cero. Recibirás una clave de recuperación que debes guardar en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repartez de zéro. Vous recevrez une clé de récupération à conserver en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da zero. Riceverai una chiave di recupero da conservare al sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく始めます。安全に保管する復旧キーが発行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 시작합니다. 안전하게 보관할 복구 키를 받게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin vanaf nul. Je krijgt een herstelsleutel die je veilig moet bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij od nowa. Otrzymasz klucz odzyskiwania, który trzeba bezpiecznie przechowywać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece do zero. Você receberá uma chave de recuperação para guardar em segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните с нуля. Вы получите ключ восстановления, который нужно хранить в надежном месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıfırdan başlayın. Güvenle saklamanız gereken bir kurtarma anahtarı alacaksınız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全新开始。你将获得一个需妥善保管的恢复密钥。"
          }
        }
      }
    },
