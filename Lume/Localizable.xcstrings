          "stringUnit" : {
            "state" : "translated",
            "value" : "为没有字幕的内容下载字幕。"
          }
        }
      }
    },
    "Downloaded artwork will be removed and re-downloaded when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الصور المنزّلة وتُنزَّل مجددًا عند الحاجة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heruntergeladene Bilder werden entfernt und bei Bedarf erneut geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ilustraciones descargadas se eliminarán y se volverán a descargar cuando sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visuels téléchargés seront supprimés puis retéléchargés si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini scaricate verranno rimosse e riscaricate quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアートワークは削除され、必要に応じて再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드된 아트워크는 제거되고 필요할 때 다시 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedownloade illustraties worden verwijderd en wanneer nodig opnieuw gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrane grafiki zostaną usunięte i w razie potrzeby pobrane ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens baixadas serão removidas e baixadas novamente quando necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загруженные изображения будут удалены и загружены снова при необходимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen görseller kaldırılacak ve gerektiğinde yeniden indirilecek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载的封面将被移除，并在需要时重新下载。"
          }
        }
      }
    },
    "Downloaded movies and episodes appear here for offline viewing." : {
      "localizations" : {
        "ar" : {
