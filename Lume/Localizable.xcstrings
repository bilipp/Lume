    "Store it somewhere safe, like a password manager. Never share it." : {
      "comment" : "Advice under the Lume Cloud recovery key; 'it' is the recovery key.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظه في مكان آمن، مثل مدير كلمات السر. لا تشاركه أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre ihn an einem sicheren Ort auf, etwa in einem Passwortmanager. Teile ihn niemals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store it somewhere safe, like a password manager. Never share it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdala en un lugar seguro, como un gestor de contraseñas. No la compartas nunca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez-la en lieu sûr, par exemple dans un gestionnaire de mots de passe. Ne la partagez jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservala in un luogo sicuro, ad esempio in un gestore di password. Non condividerla mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードマネージャなど安全な場所に保管してください。決して誰とも共有しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호 관리자와 같은 안전한 곳에 보관하세요. 절대 공유하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar hem op een veilige plek, zoals een wachtwoordbeheerder. Deel hem nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuj go w bezpiecznym miejscu, np. w menedżerze haseł. Nigdy go nikomu nie udostępniaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde-a em um lugar seguro, como um gerenciador de senhas. Nunca a compartilhe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните его в надежном месте, например в менеджере паролей. Никому его не сообщайте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu parola yöneticisi gibi güvenli bir yerde saklayın. Asla kimseyle paylaşmayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将它存放在安全的地方，例如密码管理器。切勿分享给他人。"
          }
        }
      }
    },
