    "The connection timed out. Check the URL and your network, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت مهلة الاتصال. تحقق من الـURL ومن شبكتك، ثم حاول مرة أخرى."
