    "Lower probe sizes and analyze durations start streams faster but can miss audio or subtitle tracks." : {
      "comment" : "AetherEngine options in Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ أحجام الفحص ومدد التحليل الأصغر البث أسرع، لكنها قد تفوّت مسارات الصوت أو الترجمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere Prüfgrößen und Analysedauern starten Streams schneller, können aber Audio- oder Untertitelspuren übersehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower probe sizes and analyze durations start streams faster but can miss audio or subtitle tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaños de sondeo y duraciones de análisis menores inician las transmisiones antes, pero pueden omitir pistas de audio o subtítulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des tailles de sondage et des durées d’analyse plus faibles démarrent les flux plus vite, mais peuvent manquer des pistes audio ou de sous-titres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensioni di analisi e durate di analisi minori avviano gli stream prima, ma possono non rilevare tracce audio o sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プローブサイズと解析時間を小さくするとストリームの開始は速くなりますが、オーディオや字幕のトラックを見落とす場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로브 크기와 분석 시간을 줄이면 스트림이 더 빨리 시작되지만 오디오나 자막 트랙을 놓칠 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een kleinere probegrootte en analyseduur starten streams sneller, maar kunnen audio- of ondertitelsporen worden gemist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniejsze rozmiary próbkowania i krótszy czas analizy przyspieszają start strumieni, ale mogą pominąć ścieżki audio lub napisów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamanhos de sondagem e durações de análise menores iniciam os streams mais rápido, mas podem deixar passar faixas de áudio ou legendas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меньшие объем проверки и длительность анализа ускоряют запуск потоков, но могут пропустить звуковые дорожки или субтитры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha düşük yoklama boyutları ve analiz süreleri yayınları daha hızlı başlatır ancak ses veya altyazı kanallarını kaçırabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较小的探测大小和分析时长能更快开始播放，但可能遗漏音频或字幕轨道。"
          }
        }
      }
    },
