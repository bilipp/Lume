    "Show the Sports tab. The fixtures rail on Home follows your Home layout settings." : {
      "comment" : "Footer under the Show Sports Tab toggle. The Home rail is a separate Home layout section.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار علامة تبويب الرياضة. يتبع صف المباريات في الرئيسية إعدادات تخطيط الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Tab „Sport“. Die Spiele-Reihe auf Home folgt deinen Home-Layout-Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la pestaña Deportes. El carrusel de partidos en Inicio sigue los ajustes de diseño de Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche l’onglet Sports. La rangée de matchs de l’accueil suit vos réglages de disposition de l’accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la scheda Sport. La riga delle partite nella Home segue le impostazioni del layout Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スポーツタブを表示します。ホームの試合行はホームレイアウトの設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스포츠 탭을 표시합니다. 홈의 경기 행은 홈 레이아웃 설정을 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon het tabblad Sport. De wedstrijdenrij in Thuis volgt je indelingsinstellingen voor Thuis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj kartę Sport. Rząd z meczami na ekranie głównym zależy od ustawień układu ekranu głównego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a aba Esportes. A fileira de jogos na Início segue as configurações de layout da Início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать вкладку «Спорт». Лента матчей на главном экране зависит от настроек главного экрана."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spor sekmesini gösterir. Ana Sayfa'daki maç şeridi, Ana Sayfa düzeni ayarlarınızı izler."
