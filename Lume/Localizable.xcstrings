    },
    "The downloaded file will be removed. You can re-download it later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة الملف الذي تم تنزيله. يمكنك تنزيله مرة أخرى لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladene Datei wird entfernt. Du kannst sie später erneut herunterladen."
