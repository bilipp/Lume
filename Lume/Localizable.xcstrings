          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد الجسر يتعرّف على جهاز Apple TV هذا. انسَ الجسر واقترن به مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bridge kennt dieses Apple TV nicht mehr. Entferne die Bridge und kopple sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bridge no longer knows this Apple TV. Forget the bridge and pair it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente ya no reconoce este Apple TV. Olvida el puente y vuelve a vincularlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pont ne reconnaît plus cette Apple TV. Oubliez le pont, puis jumelez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bridge non riconosce più questa Apple TV. Dimentica il bridge e abbinalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブリッジがこの Apple TV を認識しなくなりました。ブリッジの登録を解除して、もう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브리지가 더 이상 이 Apple TV를 인식하지 않습니다. 브리지를 삭제하고 다시 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bridge herkent deze Apple TV niet meer. Vergeet de bridge en koppel hem opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostek nie rozpoznaje już tego Apple TV. Zapomnij mostek i sparuj go ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bridge não reconhece mais esta Apple TV. Esqueça a bridge e pareie-a novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мост больше не распознает этот Apple TV. Удалите мост и создайте пару заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü bu Apple TV'yi artık tanımıyor. Köprüyü unutun ve yeniden eşleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桥接器已不再识别此 Apple TV。请忘记该桥接器，然后重新配对。"
          }
        }
      }
    },
    "settings.hue.error.unreachable" : {
      "comment" : "Philips Hue settings: no bridge answered at the address (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى جسر Hue على هذا العنوان. تأكد من أنه على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
