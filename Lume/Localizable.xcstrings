    "Lists Recordings in the Live TV sidebar, below Favorites and Recently Watched." : {
      "comment" : "tvOS Settings › Live TV › Recordings: footnote under the Show in Live TV Sidebar switch.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض التسجيلات في الشريط الجانبي للبث المباشر، أسفل المفضلة والمُشاهَدة مؤخرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Aufnahmen in der Live-TV-Seitenleiste unter Favoriten und Kürzlich gesehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists Recordings in the Live TV sidebar, below Favorites and Recently Watched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra Grabaciones en la barra lateral de TV en directo, debajo de Favoritos y Visto recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche Enregistrements dans la barre latérale de la TV en direct, sous Favoris et Vu récemment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra Registrazioni nella barra laterale della TV in diretta, sotto Preferiti e Visti di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブTVのサイドバーで、お気に入りと最近視聴した項目の下に録画を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브 TV 사이드바의 즐겨찾기와 최근 시청함 아래에 녹화를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont Opnamen in de navigatiekolom van Live tv, onder Favorieten en Onlangs bekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje nagrania na pasku bocznym TV na żywo, pod Ulubionymi i Ostatnio oglądanymi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra Gravações na barra lateral da TV ao vivo, abaixo de Favoritos e Assistidos Recentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать записи в боковом меню ТВ под разделами «Избранное» и «Недавно просмотренное»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtları Canlı TV kenar çubuğunda, Favoriler ve Son İzlenenler'in altında listeler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
