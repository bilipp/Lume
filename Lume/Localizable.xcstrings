    "Changes stay on this device until you turn sync back on. Nothing is deleted." : {
      "comment" : "Confirmation message before turning sync off on this device.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى التغييرات على هذا الجهاز حتى تعيد تشغيل المزامنة. لن يُحذف أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen bleiben auf diesem Gerät, bis du die Synchronisierung wieder einschaltest. Es wird nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes stay on this device until you turn sync back on. Nothing is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se quedan en este dispositivo hasta que vuelvas a activar la sincronización. No se elimina nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications restent sur cet appareil jusqu’à ce que vous réactiviez la synchronisation. Rien n’est supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche restano su questo dispositivo finché non riattivi la sincronizzazione. Non viene eliminato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を再びオンにするまで、変更はこのデバイスに残ります。何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화를 다시 켤 때까지 변경 사항은 이 기기에 남아 있습니다. 아무것도 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen blijven op dit apparaat totdat je synchronisatie weer inschakelt. Er wordt niets verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany pozostaną na tym urządzeniu, dopóki nie włączysz ponownie synchronizacji. Nic nie zostanie usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações ficam neste dispositivo até você reativar a sincronização. Nada é apagado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения останутся на этом устройстве, пока вы снова не включите синхронизацию. Ничего не будет удалено."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşzamanlamayı yeniden açana kadar değişiklikler bu aygıtta kalır. Hiçbir şey silinmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你重新开启同步之前，更改会保留在此设备上。不会删除任何内容。"
          }
        }
      }
    },
