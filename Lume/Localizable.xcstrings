          }
        }
      }
    },
    "iCloud rejected some changes. Export a diagnostic report for details." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض iCloud بعض التغييرات. صدِّر تقرير تشخيص للاطلاع على التفاصيل."
          }
        },
        "de" : {
          "stringUnit" : {
