            "value" : "위/아래"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omhoog en omlaag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Góra i dół"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cima e baixo"
          }
        },
        "ru" : {
          "stringUnit" : {
