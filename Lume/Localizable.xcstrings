    "Hold a channel to add it to Favorites or Multi-View" : {
      "comment" : "tvOS Live TV guide: hint under the guide. Holding the remote's select button on a channel name offers Add to Favorites and Start Multi-View.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على قناة لإضافتها إلى المفضلة أو العرض المتعدد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Sender gedrückt, um ihn zu den Favoriten oder zu Multi-View hinzuzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a channel to add it to Favorites or Multi-View"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un canal para añadirlo a Favoritos o a Multi-View"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez une chaîne enfoncée pour l’ajouter aux Favoris ou à Multi-View"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un canale per aggiungerlo ai Preferiti o a Multi-View"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルを長押しすると、お気に入りやマルチビューに追加できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 길게 눌러 즐겨찾기나 멀티뷰에 추가하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een zender ingedrukt om hem aan Favorieten of Multi-View toe te voegen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj kanał, aby dodać go do ulubionych lub Multi-View"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um canal pressionado para adicioná-lo aos Favoritos ou ao Multi-View"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте канал, чтобы добавить его в избранное или Multi-View"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favorilere veya Çoklu Görünüm'e eklemek için bir kanalı basılı tutun"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住频道可将其添加到收藏或多画面"
          }
        }
      }
    },
    "Hold a channel to add it to Favorites or Multi-View, or to record it" : {
      "comment" : "tvOS Live TV guide: hint under the guide when a recording server is paired. Holding the remote's select button on a channel name offers Add to Favorites, Start Multi-View and Record.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على قناة لإضافتها إلى المفضلة أو العرض المتعدد، أو لتسجيلها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Sender gedrückt, um ihn zu den Favoriten oder zu Multi-View hinzuzufügen oder um ihn aufzunehmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a channel to add it to Favorites or Multi-View, or to record it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un canal para añadirlo a Favoritos o a Multi-View, o para grabarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez une chaîne enfoncée pour l’ajouter aux Favoris ou à Multi-View, ou pour l’enregistrer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto un canale per aggiungerlo ai Preferiti o a Multi-View, o per registrarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルを長押しすると、お気に入りやマルチビューに追加したり、録画したりできます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널을 길게 눌러 즐겨찾기나 멀티뷰에 추가하거나 녹화하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een zender ingedrukt om hem aan Favorieten of Multi-View toe te voegen of om hem op te nemen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj kanał, aby dodać go do ulubionych lub Multi-View albo go nagrać"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha um canal pressionado para adicioná-lo aos Favoritos ou ao Multi-View, ou para gravá-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте канал, чтобы добавить его в избранное или Multi-View либо записать"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
