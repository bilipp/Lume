    "It stops syncing with Lume Cloud. Anything already on it stays there." : {
      "comment" : "Message of the confirmation before removing another device from the Lume Cloud account.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوقف عن المزامنة مع Lume Cloud. وسيبقى عليه كل ما هو موجود فيه بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es synchronisiert nicht mehr mit Lume Cloud. Alles, was bereits darauf ist, bleibt dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stops syncing with Lume Cloud. Anything already on it stays there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de sincronizarse con Lume Cloud. Todo lo que ya tenga se queda en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cesse de se synchroniser avec Lume Cloud. Tout ce qui s’y trouve déjà y reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetterà di sincronizzarsi con Lume Cloud. Tutto ciò che contiene già resterà lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloudとの同期が停止します。すでにそのデバイスにあるデータはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud와의 동기화가 중지됩니다. 해당 기기에 이미 있는 항목은 그대로 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat synchroniseert niet meer met Lume Cloud. Wat er al op staat, blijft daar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie przestanie synchronizować się z Lume Cloud. Wszystko, co już na nim jest, pozostanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele deixa de sincronizar com o Lume Cloud. Tudo o que já estiver nele permanece lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно перестанет синхронизироваться с Lume Cloud. Все, что уже на нем есть, останется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aygıtın Lume Cloud ile eşzamanlanması durur. Üzerinde zaten bulunanlar orada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它将停止与 Lume Cloud 同步。其上已有的内容会保留。"
          }
        }
      }
    },
