    "That device uses a different Lume Cloud server." : {
      "comment" : "Error when the pairing device belongs to another Lume Cloud server (e.g. a test build). Lume Cloud is a product name; keep it in Latin script.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم ذلك الجهاز خادم Lume Cloud مختلفًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät nutzt einen anderen Lume Cloud-Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That device uses a different Lume Cloud server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese dispositivo usa otro servidor de Lume Cloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil utilise un autre serveur Lume Cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel dispositivo usa un server Lume Cloud diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデバイスは別のLume Cloudサーバーを使用しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 기기는 다른 Lume Cloud 서버를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat apparaat gebruikt een andere Lume Cloud-server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie korzysta z innego serwera Lume Cloud."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse dispositivo usa outro servidor do Lume Cloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство использует другой сервер Lume Cloud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aygıt farklı bir Lume Cloud sunucusu kullanıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该设备使用的是另一个 Lume Cloud 服务器。"
          }
        }
      }
    },
    "That folder is empty. Enter the full path of the folder that holds your media — a server's root address usually lists nothing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المجلد فارغ. أدخل المسار الكامل للمجلد الذي يحتوي على الوسائط — عادةً لا يعرض العنوان الجذر للخادم أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner ist leer. Gib den vollständigen Pfad des Ordners mit deinen Medien ein – die Stammadresse eines Servers listet meist nichts auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa carpeta está vacía. Introduce la ruta completa de la carpeta que contiene tus medios: la dirección raíz de un servidor normalmente no muestra nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier est vide. Saisissez le chemin complet du dossier contenant vos médias — l’adresse racine d’un serveur n’affiche généralement rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cartella è vuota. Inserisci il percorso completo della cartella che contiene i tuoi contenuti: l’indirizzo principale di un server di solito non elenca nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダは空です。メディアが入っているフォルダの完全なパスを入力してください。サーバーのルートアドレスでは通常何も表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 폴더가 비어 있습니다. 미디어가 들어 있는 폴더의 전체 경로를 입력하세요. 서버의 루트 주소에서는 보통 아무것도 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die map is leeg. Voer het volledige pad in van de map met je media – het hoofdadres van een server toont meestal niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten folder jest pusty. Wprowadź pełną ścieżkę folderu z multimediami — adres główny serwera zwykle niczego nie wyświetla."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pasta está vazia. Digite o caminho completo da pasta que contém sua mídia — o endereço raiz de um servidor normalmente não lista nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка пуста. Введите полный путь к папке с медиафайлами — корневой адрес сервера обычно ничего не показывает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasör boş. Medyanızın bulunduğu klasörün tam yolunu girin — bir sunucunun kök adresi genellikle hiçbir şey listelemez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件夹为空。请输入存放媒体文件的文件夹完整路径——服务器的根地址通常不会列出任何内容。"
          }
        }
      }
    },
    "That isn’t a recovery key." : {
      "comment" : "Error when the entered Lume Cloud recovery key has the wrong length or characters.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
