          }
        }
      }
    },
    "Your Lume Cloud account was deleted. Sync is off; your data stays on this device." : {
      "comment" : "Alert after the Lume Cloud account was deleted on a build without iCloud; sync is now off. Lume Cloud is a product name; keep it in Latin script.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف حساب Lume Cloud الخاص بك. المزامنة متوقفة؛ تبقى بياناتك على هذا الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Lume Cloud-Account wurde gelöscht. Die Synchronisierung ist aus; deine Daten bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Lume Cloud account was deleted. Sync is off; your data stays on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Lume Cloud se ha eliminado. La sincronización está desactivada; tus datos se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte Lume Cloud a été supprimé. La synchronisation est désactivée ; vos données restent sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account Lume Cloud è stato eliminato. La sincronizzazione è disattivata; i tuoi dati restano su questo dispositivo."
