    "Sign in to iCloud in Settings to sync your playlists and viewing across devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى iCloud في الإعدادات لمزامنة قوائم التشغيل والمشاهدة عبر أجهزتك."
          }
        },
        "de" : {
          "stringUnit" : {
