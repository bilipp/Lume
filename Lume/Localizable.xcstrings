    "settings.hue.forget.confirmMessage" : {
      "comment" : "Philips Hue settings: message of the Forget Bridge alert (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف Lume عن مزامنة الأضواء على جهاز Apple TV هذا ويحذف مفتاح الجسر. لاستخدامه مرة أخرى، اقترن به باستخدام زر الربط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume synchronisiert auf diesem Apple TV keine Lampen mehr und löscht den Schlüssel der Bridge. Um sie wieder zu nutzen, kopple sie mit der Link-Taste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume stops syncing lights on this Apple TV and removes the bridge's key. To use it again, pair it with the link button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume dejará de sincronizar las luces en este Apple TV y eliminará la clave del puente. Para volver a usarlo, vincúlalo con el botón de enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume cesse de synchroniser les lampes sur cette Apple TV et supprime la clé du pont. Pour l’utiliser à nouveau, jumelez-le avec le bouton de liaison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume smette di sincronizzare le luci su questa Apple TV e rimuove la chiave del bridge. Per usarlo di nuovo, abbinalo con il pulsante di collegamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume はこの Apple TV でのライトの同期を停止し、ブリッジのキーを削除します。再び使うには、リンクボタンでペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume가 이 Apple TV에서 조명 동기화를 중단하고 브리지 키를 삭제합니다. 다시 사용하려면 링크 버튼으로 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume stopt met het synchroniseren van lampen op deze Apple TV en verwijdert de sleutel van de bridge. Koppel hem met de linkknop om hem opnieuw te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume przestanie synchronizować światła na tym Apple TV i usunie klucz mostka. Aby znów go używać, sparuj go przyciskiem łączenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lume deixa de sincronizar as luzes nesta Apple TV e remove a chave da bridge. Para usá-la novamente, pareie-a com o botão de link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume перестанет синхронизировать свет на этом Apple TV и удалит ключ моста. Чтобы снова использовать мост, создайте пару с помощью кнопки связи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume bu Apple TV'de ışıkları eşzamanlamayı durdurur ve köprünün anahtarını siler. Yeniden kullanmak için bağlantı düğmesiyle eşleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume 将停止在此 Apple TV 上同步灯光，并移除桥接器的密钥。如需再次使用，请通过链接按钮重新配对。"
          }
        }
      }
    },
