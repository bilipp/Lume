    "Prepare the report, then share it or attach it to an email to %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعدّ التقرير، ثم شاركه أو أرفقه برسالة بريد إلكتروني إلى %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle den Bericht und teile ihn dann oder hänge ihn an eine E-Mail an %@ an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara el informe y luego compártelo o adjúntalo a un correo para %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez le rapport, puis partagez-le ou joignez-le à un e-mail adressé à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara il rapporto, poi condividilo o allegalo a un'e-mail a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートを準備してから、共有するか %@ 宛てのメールに添付してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서를 준비한 다음 공유하거나 %@(으)로 보내는 이메일에 첨부하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
