    "Download movies and episodes for offline playback. Auto-delete removes the file once you've finished watching." : {
      "comment" : "A description of the download settings in the settings screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل الأفلام والحلقات للتشغيل دون اتصال. يزيل الحذف التلقائي الملف بمجرد انتهائك من المشاهدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Filme und Folgen für die Offline-Wiedergabe herunter. Die automatische Löschfunktion entfernt die Datei, sobald du sie vollständig angesehen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga películas y episodios para reproducirlos sin conexión. La eliminación automática borra el archivo una vez que terminas de verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des films et des épisodes pour les lire hors ligne. La suppression automatique retire le fichier une fois le visionnage terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica film ed episodi per la riproduzione offline. L'eliminazione automatica rimuove il file una volta terminata la visione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やエピソードをダウンロードしてオフライン再生できます。自動削除は、視聴を終えるとファイルを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 재생을 위해 영화와 에피소드를 다운로드하세요. 자동 삭제는 시청을 마치면 파일을 제거합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download films en afleveringen om offline af te spelen. Automatisch verwijderen wist het bestand zodra je het helemaal hebt bekeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieraj filmy i odcinki do odtwarzania offline. Automatyczne usuwanie kasuje plik, gdy skończysz oglądać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe filmes e episódios para reprodução offline. A exclusão automática remove o arquivo assim que você termina de assistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайте фильмы и серии для просмотра офлайн. Автоудаление стирает файл, когда вы досмотрите его до конца."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmleri ve bölümleri çevrimdışı oynatmak için indirin. Otomatik silme, izlemeyi bitirdiğinizde dosyayı kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载电影和剧集以便离线播放。自动删除会在您观看完毕后移除文件。"
          }
        }
      }
    },
    "Download subtitles for anything that ships without them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نزّل الترجمة لأي محتوى لا يتضمنها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Untertitel für alles herunter, was ohne sie ausgeliefert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga subtítulos para todo lo que no los incluya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des sous-titres pour tout ce qui n’en propose pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica i sottotitoli per tutto ciò che ne è sprovvisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕のないコンテンツには字幕をダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막이 없는 콘텐츠의 자막을 다운로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download ondertitels voor alles wat er zonder wordt geleverd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieraj napisy do wszystkiego, co ich nie zawiera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe legendas para o que não vier com elas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайте субтитры для всего, что идет без них."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazısız gelen her şey için altyazı indirin."
          }
