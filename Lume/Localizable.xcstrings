    "Record a channel from its menu, the guide or the player. Recordings appear here." : {
      "comment" : "Recordings library empty-state description.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل قناة من قائمتها أو من دليل البرامج أو من المشغّل. تظهر التسجيلات هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm einen Sender über sein Menü, den Guide oder den Player auf. Aufnahmen erscheinen hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record a channel from its menu, the guide or the player. Recordings appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba un canal desde su menú, la guía o el reproductor. Las grabaciones aparecen aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez une chaîne depuis son menu, le guide ou le lecteur. Les enregistrements apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra un canale dal suo menu, dalla guida o dal player. Le registrazioni appaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルのメニュー、番組表、またはプレーヤーから録画できます。録画はここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채널 메뉴, 편성표 또는 플레이어에서 채널을 녹화하세요. 녹화가 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem een zender op via het menu, de gids of de speler. Opnamen verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagraj kanał z jego menu, programu TV lub odtwarzacza. Nagrania pojawią się tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grave um canal pelo menu dele, pelo guia ou pelo player. As gravações aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте канал из его меню, телегида или плеера. Записи появятся здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kanalı menüsünden, rehberden veya oynatıcıdan kaydedin. Kayıtlar burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可从频道菜单、节目指南或播放器录制频道。录制内容会显示在这里。"
          }
        }
      }
    },
    "Record for How Long?" : {
      "comment" : "Title of the duration choice shown when a channel has no guide data to record by.",
      "localizations" : {
