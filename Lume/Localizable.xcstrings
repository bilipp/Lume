        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 Jellyfin 또는 Emby 서버로 응답하지 않습니다. 서버의 기본 주소를 입력하세요. 예: http://192.168.1.10:8096"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse endereço não responde como um servidor Jellyfin ou Emby. Digite o endereço base do servidor, p. ex. http://192.168.1.10:8096."
          }
