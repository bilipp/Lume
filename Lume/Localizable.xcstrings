    "Each playlist's categories appear in this order. Drag to reorder." : {
      "comment" : "Footer under the draggable priority list on the Combined View settings page",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر فئات كل قائمة تشغيل بهذا الترتيب. اسحب لإعادة الترتيب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kategorien der Playlists erscheinen in dieser Reihenfolge. Zum Umsortieren ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each playlist's categories appear in this order. Drag to reorder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las categorías de cada lista aparecen en este orden. Arrastra para reordenar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les catégories de chaque playlist apparaissent dans cet ordre. Faites glisser pour réorganiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le categorie di ogni playlist appaiono in quest’ordine. Trascina per riordinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プレイリストのカテゴリはこの順に表示されます。ドラッグして並べ替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 재생목록의 카테고리가 이 순서로 표시됩니다. 드래그하여 순서를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De categorieën van elke playlist verschijnen in deze volgorde. Sleep om de volgorde te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kategorie z poszczególnych playlist pojawiają się w tej kolejności. Przeciągnij, aby ją zmienić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As categorias de cada playlist aparecem nesta ordem. Arraste para reordenar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Категории плейлистов отображаются в этом порядке. Перетащите, чтобы изменить порядок."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her oynatma listesinin kategorileri bu sırayla görünür. Yeniden sıralamak için sürükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各播放列表的类别按此顺序显示。拖动以重新排序。"
          }
        }
      }
    },
    "Each profile has its own watch history, progress and favorites, synced across your devices." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل ملف شخصي سجل مشاهدة وتقدّم ومفضلة خاصة به، تتم مزامنتها عبر أجهزتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Profil hat seinen eigenen Wiedergabeverlauf, Fortschritt und Favoriten, synchronisiert zwischen deinen Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tiene su propio historial de visualización, progreso y favoritos, sincronizados entre tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil possède son propre historique de visionnage, sa progression et ses favoris, synchronisés sur tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo ha la propria cronologia di visione, i propri progressi e i propri preferiti, sincronizzati su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロファイルは独自の視聴履歴、進行状況、お気に入りを持ち、デバイス間で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프로필은 고유한 시청 기록, 진행 상황, 즐겨찾기를 가지며, 기기 간에 동기화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk profiel heeft een eigen kijkgeschiedenis, voortgang en favorieten, gesynchroniseerd tussen je apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy profil ma własną historię oglądania, postępy i ulubione, synchronizowane między Twoimi urządzeniami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil tem seu próprio histórico, progresso e favoritos, sincronizados entre seus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого профиля своя история просмотра, прогресс и избранное с синхронизацией между вашими устройствами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her profilin kendi izleme geçmişi, ilerlemesi ve favorileri vardır; bunlar aygıtlarınız arasında eşzamanlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个个人资料都有独立的观看历史、进度和收藏，并在您的各设备间同步。"
          }
        }
      }
    },
