    "settings.hue.sync.footer" : {
      "comment" : "Philips Hue settings: footer explaining light sync (tvOS).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع أضواء منطقة الترفيه في Hue الألوان عند حواف الصورة أثناء تشغيل الفيديو. اختر «إيقاف» أو مستوى آخر من قائمة المشغّل في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lampen eines Hue Entertainment-Bereichs folgen während der Wiedergabe den Farben an den Bildrändern. Wähle jederzeit „Aus“ oder eine andere Stufe im Menü des Players."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lights of a Hue entertainment area follow the colours at the edges of the picture while video plays. Choose Off or another level from the player's menu at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las luces de un área de entretenimiento Hue siguen los colores de los bordes de la imagen mientras se reproduce el vídeo. Elige Desactivado u otro nivel en el menú del reproductor en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lampes d’une zone de divertissement Hue suivent les couleurs des bords de l’image pendant la lecture. Choisissez Désactivé ou un autre niveau dans le menu du lecteur à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le luci di un’area di intrattenimento Hue seguono i colori ai bordi dell’immagine durante la riproduzione. Scegli Disattivato o un altro livello dal menu del player in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオの再生中、Hue エンターテイメントエリアのライトが映像の端の色に合わせて変化します。プレーヤーのメニューからいつでも「オフ」または別のレベルを選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오가 재생되는 동안 Hue 엔터테인먼트 영역의 조명이 화면 가장자리의 색상을 따라 바뀝니다. 언제든지 플레이어 메뉴에서 끔 또는 다른 단계를 선택할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lampen van een Hue-entertainmentruimte volgen tijdens het afspelen de kleuren aan de randen van het beeld. Kies op elk moment “Uit” of een ander niveau in het menu van de speler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas odtwarzania światła strefy rozrywki Hue podążają za kolorami przy krawędziach obrazu. W każdej chwili możesz wybrać „Wył.” lub inny poziom w menu odtwarzacza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As luzes de uma área de entretenimento Hue acompanham as cores das bordas da imagem durante a reprodução. Escolha Desativado ou outro nível no menu do player a qualquer momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время воспроизведения лампы зоны развлечений Hue повторяют цвета по краям изображения. В любой момент можно выбрать «Выкл.» или другой уровень в меню плеера."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video oynatılırken bir Hue eğlence alanının ışıkları görüntünün kenarlarındaki renkleri izler. İstediğiniz zaman oynatıcının menüsünden Kapalı'yı veya başka bir düzeyi seçebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放视频时，Hue 娱乐区域的灯光会跟随画面边缘的颜色变化。你可以随时在播放器菜单中选择“关”或其他级别。"
          }
        }
      }
    },
