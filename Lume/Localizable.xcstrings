    "Lume Cloud is busy. Sync will retry automatically." : {
      "comment" : "Sync status detail when the server rate-limits. Lume Cloud is a product name; keep it in Latin script.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud مشغول. ستُعاد محاولة المزامنة تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud ist ausgelastet. Die Synchronisierung wird automatisch erneut versucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lume Cloud is busy. Sync will retry automatically."
          }
        },
        "es" : {
