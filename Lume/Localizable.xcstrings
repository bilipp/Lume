    "An item is too large for Lume Cloud and stays on this device." : {
      "comment" : "Sync error when one synced item exceeds the Lume Cloud size limit. Lume Cloud is a product name; keep it in Latin script.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحد العناصر كبير جدًا على Lume Cloud وسيبقى على هذا الجهاز."
