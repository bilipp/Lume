    "Surround Compatible" : {
      "comment" : "An AetherEngine audio mode: lossy surround that works on every audio output.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوافق مع الصوت المحيطي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround-kompatibel"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround Compatible"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con envolvente"
          }
        },
        "fr" : {
          "stringUnit" : {
