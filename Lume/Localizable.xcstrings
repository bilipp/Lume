    "Move up or down to position, then select to place. Press Menu to cancel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحرّك للأعلى أو للأسفل لتحديد الموضع، ثم اختر للوضع. اضغط على زر القائمة للإلغاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben oder unten bewegen, dann zum Platzieren auswählen. Menü-Taste drücken zum Abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve hacia arriba o hacia abajo para colocar y luego selecciona para situar. Pulsa Menú para cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez vers le haut ou le bas pour positionner, puis sélectionnez pour placer. Appuyez sur Menu pour annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostati in alto o in basso per posizionarlo, poi seleziona per collocarlo. Premi Menu per annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下に移動して位置を決め、選択して配置します。キャンセルするにはメニューを押します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 또는 아래로 이동하여 위치를 정한 다음 선택하여 배치하세요. 취소하려면 메뉴를 누르세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga omhoog of omlaag naar de gewenste plek en selecteer om te plaatsen. Druk op Menu om te annuleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w górę lub w dół, a następnie wybierz, aby umieścić. Naciśnij Menu, aby anulować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova para cima ou para baixo para posicionar e selecione para colocar. Pressione Menu para cancelar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещайте вверх или вниз, затем выберите, чтобы поставить на место. Нажмите «Меню» для отмены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumlandırmak için yukarı veya aşağı hareket ettirin, yerleştirmek için seçin. İptal etmek için Menü'ye basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下移动以定位，然后选择以放置。按“菜单”取消。"
          }
        }
      }
    },
