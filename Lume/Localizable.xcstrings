    "Subtitles will look like this.\nPick a style that's easy to read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستبدو الترجمة هكذا.\nاختر نمطًا سهل القراءة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sehen Untertitel aus.\nWähle einen gut lesbaren Stil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así se verán los subtítulos.\nElige un estilo fácil de leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici à quoi ressembleront les sous-titres.\nChoisissez un style facile à lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecco come appariranno i sottotitoli.\nScegli uno stile facile da leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕はこのように表示されます。\n読みやすいスタイルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자막이 이렇게 표시됩니다.\n읽기 쉬운 스타일을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zo zien ondertitels eruit.\nKies een stijl die goed leesbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak będą wyglądać napisy.\nWybierz styl, który dobrze się czyta."
