    "HDR Base Layer Only skips the enhancement layer of layered HDR video. " : {
      "comment" : "AetherEngine options in Settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتخطى خيار طبقة HDR الأساسية فقط طبقة التحسين في فيديو HDR متعدد الطبقات. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur HDR-Basisschicht überspringt die Erweiterungsschicht von mehrschichtigem HDR-Video. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HDR Base Layer Only skips the enhancement layer of layered HDR video. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo capa base HDR omite la capa de mejora del vídeo HDR por capas. "
