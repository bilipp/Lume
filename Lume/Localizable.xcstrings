    "Something not working? Send a diagnostic report to the developer." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هناك شيء لا يعمل؟ أرسل تقرير تشخيص إلى المطوّر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert etwas nicht? Sende einen Diagnosebericht an den Entwickler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Algo no funciona? Envía un informe de diagnóstico al desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose ne fonctionne pas ? Envoyez un rapport de diagnostic au développeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcosa non funziona? Invia un rapporto di diagnostica allo sviluppatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまく動作しない場合は、診断レポートを開発者に送信してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제대로 작동하지 않나요? 개발자에게 진단 보고서를 보내 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt er iets niet? Stuur een diagnostisch rapport naar de ontwikkelaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś nie działa? Wyślij raport diagnostyczny do twórcy aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo não está funcionando? Envie um relatório de diagnóstico ao desenvolvedor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что-то не работает? Отправьте отчет диагностики разработчику."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şey çalışmıyor mu? Geliştiriciye bir tanılama raporu gönderin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遇到问题？请向开发者发送诊断报告。"
          }
        }
      }
    },
