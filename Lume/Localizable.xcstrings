    "This permanently removes %@'s watch history, progress and favorites. Your library is not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة سجل المشاهدة والتقدّم والمفضلة الخاصة بـ %@ نهائيًا. لن تتأثر مكتبتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt dauerhaft den Wiedergabeverlauf, den Fortschritt und die Favoriten von %@. Deine Mediathek ist nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente el historial de visualización, el progreso y los favoritos de %@. Tu biblioteca no se ve afectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime définitivement l’historique de visionnage, la progression et les favoris de %@. Votre bibliothèque n’est pas affectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuove definitivamente la cronologia di visione, i progressi e i preferiti di %@. La tua libreria non viene modificata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の視聴履歴、進行状況、お気に入りが完全に削除されます。ライブラリには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 시청 기록, 진행 상황, 즐겨찾기가 영구적으로 제거됩니다. 라이브러리에는 영향을 주지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de kijkgeschiedenis, voortgang en favorieten van %@ definitief verwijderd. Je bibliotheek blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie historii oglądania, postępu i ulubionych profilu %@. Biblioteka pozostanie bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove permanentemente o histórico, o progresso e os favoritos de %@. Sua biblioteca não é afetada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История просмотра, прогресс и избранное профиля %@ будут удалены без возможности восстановления. Медиатека не затрагивается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %@ profilinin izleme geçmişini, ilerlemesini ve favorilerini kalıcı olarak siler. Arşiviniz etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久移除%@的观看历史、进度和收藏。您的媒体库不受影响。"
          }
        }
      }
    },
    "This permanently removes this profile's watch history, progress and favorites. Your library is not affected." : {
      "localizations" : {
