    "Scan the code with your phone or visit %@." : {
      "comment" : "tvOS Recording Server settings: under the setup guide's QR code. %@ is the guide's web address.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز ضوئيًا بهاتفك أو تفضّل بزيارة %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit deinem Handy oder besuche %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con tu teléfono o visita %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec votre téléphone ou rendez-vous sur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice con il telefono o visita %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンでコードをスキャンするか、%@ にアクセスしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰으로 코드를 스캔하거나 %@ 에 방문하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de code met je telefoon of ga naar %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod telefonem lub odwiedź %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com seu telefone ou acesse %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код телефоном или перейдите на %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodu telefonunuzla tarayın veya %@ adresini ziyaret edin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机扫描二维码，或访问 %@。"
          }
        }
      }
    },
    "Scan the code with your phone to email a diagnostic summary to %@. Add a sentence about what went wrong before you send it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز ضوئيًا بهاتفك لإرسال ملخص تشخيصي بالبريد الإلكتروني إلى %@. أضف جملة عمّا حدث من خطأ قبل الإرسال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit deinem Telefon, um eine Diagnosezusammenfassung per E-Mail an %@ zu senden. Beschreibe vor dem Senden kurz, was schiefgelaufen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con tu teléfono para enviar un resumen de diagnóstico por correo a %@. Añade una frase sobre lo que falló antes de enviarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec votre téléphone pour envoyer un résumé de diagnostic par e-mail à %@. Ajoutez une phrase sur ce qui n'a pas fonctionné avant l'envoi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice con il telefono per inviare un riepilogo di diagnostica via e-mail a %@. Aggiungi una frase su cosa è andato storto prima di inviarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンでコードをスキャンすると、診断の概要を %@ にメールで送信できます。送信する前に、何が起きたかを一言添えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰으로 코드를 스캔하면 진단 요약을 %@(으)로 이메일로 보낼 수 있습니다. 보내기 전에 무엇이 잘못되었는지 한 문장 덧붙여 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan de code met je telefoon om een diagnostisch overzicht per e-mail naar %@ te sturen. Beschrijf voor het versturen kort wat er misging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod telefonem, aby wysłać e‑mailem podsumowanie diagnostyczne do %@. Przed wysłaniem dodaj zdanie o tym, co poszło nie tak."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie o código com seu telefone para enviar um resumo de diagnóstico por e-mail para %@. Adicione uma frase sobre o que deu errado antes de enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код телефоном, чтобы отправить сводку диагностики на адрес %@. Перед отправкой добавьте пару слов о том, что пошло не так."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adresine bir tanılama özetini e-postayla göndermek için kodu telefonunuzla tarayın. Göndermeden önce neyin yanlış gittiğini bir cümleyle ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机扫描此代码，即可通过邮件将诊断摘要发送至 %@。发送前请补充一句说明出了什么问题。"
          }
        }
      }
    },
